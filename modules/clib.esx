	} else {
		if(-not $fwd) {
			watermark $type -fwd
		} else {
			softthrow "no watermark of that name found"
		}
	}
}

function clib([switch]$version, [switch]$fork, [switch]$dev, [switch]$vername, [switch]$libname, [switch]$esx) {
	if($libname){
		if($clibManifest.fork -eq $false) {
			watermark clib
		} else {
			write-output $($clibManifest).lib_name
		}
	}
	if($version){
		write-output $($clibManifest).version
	}
	if($vername){
		write-output $($clibManifest).ver_name
	}
	if($dev){
		write-output "by" $($clibManifest).dev_name
	}
	if($fork){
		if($clibManifest.fork -eq $true){
			write-output "is a fork"
		}else{
			write-output "not a fork"
		}
	}
	if($esx){
		if($clibManifest.esx -eq $true){
			write-output "esx build"
		}else{
			write-output "psm1 build"
		}
	}
}
# DEPRECATED // DO NOT KEEP USING CDUMP.
# if you desperately need cdump please just PR
function cdump { # this function is uh.. not very useful.. unless youre just deciding to dump clib colors
$order = @('black','darkgray','gray','lightgray','white','afterthought','debian','lesbian1','red','orange','lesbian2','yellow','butter','mint','green','cyan','pop','win11','azure','win10','cobalt','blue','indigo','violet','lesbian4','pink','lesbian3','cereal','lunar')
$line = ""
$i = 0
foreach ($name in $order) {
    $c = $color[$name]
    if (-not $c) { continue }
    $bg = $c -replace '\[38;', '[48;'
    $line += "$bg  $($color.reset)"
    $i++
    if ($i % 16 -eq 0) {
        $line += "`n"
    }
}
Write-Host $line
}

<#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++.++.+++++++++++++.-------------.----.+++++++++++.#>

function Optimize-CIM($key, $str) {
    $path = Join-Path $global:eShScriptRoot "CIM-Cache.json"
    $cache = if (Test-Path $path) { Get-Content $path -Raw | ConvertFrom-Json } else { [PSCustomObject]@{} }
    $cache | Add-Member -NotePropertyName $key -NotePropertyValue $str -Force
    $cache | ConvertTo-Json -Depth 25 | Set-Content $path
}

function Reset-CIMCache([switch]$speed) {
	if ($IsWindows -or $PSVersionTable.PSEdition -eq "Desktop" -or (!($IsLinux) -and !($IsMacOS))) {
		if (!$speed) {
			$script:osInfo = Get-CimInstance Win32_OperatingSystem -ea si
			Optimize-CIM osi $script:osInfo
			$script:csystem = get-ciminstance Win32_ComputerSystem -ea si
			Optimize-CIM csys $script:csystem
			$script:csysprod = get-ciminstance Win32_ComputerSystemProduct -ea si
			Optimize-CIM csp $script:csysprod
			#$script:cpu = get-ciminstance Win32_Processor -ea si
			#Optimize-CIM cpu $script:cpu
			$script:gpu = get-ciminstance Win32_VideoController -ea si
			Optimize-CIM gpu $script:gpu
			$script:ram = get-ciminstance Win32_PhysicalMemory -ea si
			Optimize-CIM ram $script:ram
			$script:mobo = get-ciminstance Win32_BaseBoard -ea si
			Optimize-CIM mobo $script:mobo
			$script:bios = get-ciminstance Win32_BIOS -ea si
			Optimize-CIM bios $script:bios
			Optimize-CIM ts (get-date)
		}
		if ($speed) {
			$parent = Get-CimInstance Win32_Process -Filter "ProcessId=$($PID)" -ea si
			$parentProcess = Get-CimInstance Win32_Process -Filter "ProcessId=$($parent.ParentProcessId)" -ea si
			$script:sh = $parentProcess.Name
			$script:ancestorProcess = Get-CimInstance Win32_Process -Filter "ProcessId=$($parentProcess.ParentProcessId)" -ea si
			$script:shpath = $parentProcess.path
			if ($script:sh -eq "cmd.exe") {
				$string = & $script:shpath /C ver 2>$null
				if ($string) {
					$script:cmdver = [regex]::Match($string, '(?m)^.*Version\s+([0-9][0-9\.\-a-zA-Z]+)').Groups[1].Value
				} else {
					$script:cmdver = ""
				}
			}
		}
	}
}

function Reset-OptimizedCIM {
	if (test-path (Join-Path $global:eShScriptRoot "CIM-Cache.json")) {
		$cache = Get-Content (Join-Path $global:eShScriptRoot "CIM-Cache.json") -Raw | ConvertFrom-Json
		$script:osInfo = $cache.osi
		$script:csystem = $cache.csys
		$script:csysprod = $cache.csp
		#$script:cpu = $cache.cpu
		$script:gpu = $cache.gpu
		$script:ram = $cache.ram
		$script:mobo = $cache.mobo
		$script:bios = $cache.bios
	}
}
if (test-path (Join-Path $global:eShScriptRoot "CIM-Cache.json")) {
	$cache = Get-Content (Join-Path $global:eShScriptRoot "CIM-Cache.json") -Raw | ConvertFrom-Json
	if ($cache) {
		$timestamp = [Datetime]$cache.ts
		$lifetime = if ($clibConfig.CacheLifetime) { [TimeSpan]::FromDays($clibConfig.CacheLifetime) } else { [TimeSpan]::FromDays(7) }
		if ((Get-Date) - $timestamp -gt $lifetime) {
		Reset-CIMCache
		}
	}
	Reset-OptimizedCIM
} else {
	Reset-CIMCache
}

function Reset-RegCache {
	if ($IsWindows -or $PSVersionTable.PSEdition -eq "Desktop" -or !$PSVersionTable.PSEdition) {
		$key = 'HKLM:\HARDWARE\DESCRIPTION\System\CentralProcessor\0'
		$cpuname = (Get-ItemPropertyValue $key 'ProcessorNameString').Trim()
		$cpubase = Get-ItemPropertyValue $key '~MHz'
		$threads = (Get-ChildItem 'HKLM:\HARDWARE\DESCRIPTION\System\CentralProcessor').Count
		Add-Type -Path "$global:eshScriptRoot/cpuinfo.dll"
		$cpuboost = [CPUNative]::GetBoostSpeedMHz()
		$cores = [CPUNative]::GetPhysicalCores()
		$script:cpu = @{
			"Name" = "$cpuname"
			"MaxClockSpeed" = "$cpubase"
			"NumberOfLogicalProcessors" = "$threads"
			"NumberOfCores" = "$cores"
			"BoostClockSpeed" = "$cpuboost"
		}
	}
}
Reset-RegCache
Reset-CIMCache -speed

function Test-OsRelease {
    param([string]$Path = "/etc/os-release")
    if (-not (Test-Path $Path)) { return $false }
    $lines = Get-Content $Path -ErrorAction SilentlyContinue
    if (-not $lines) { return $false }
    $validLine  = '^[A-Z_][A-Z0-9_]*=(".*"|''.*''|[^"'' ].*)$'
    $validCount = ($lines | Where-Object { $_ -match $validLine }).Count
    if ($validCount -lt 2) { return $false }
    $hasName = $lines | Where-Object { $_ -match '^(NAME|ID)=' }
    return [bool]$hasName
}
function Get-OSKey([switch]$skipOSR) {
	if($IsDiscord) { return "discord" } # wow discord os
    $os = [System.Runtime.InteropServices.RuntimeInformation]::OSDescription
	if(!$os) {
		if ($PSVersionTable.Platform -eq "Unix") {
			if (test-path /etc/os-release) {
					$os = "Linux"
			} else {
				if ($PSVersionTable.OS -match "darwin") {
					$os = "Darwin"
				} else {
					$os = "UNIX"
				}
			}
		} else {
			$os = $PSVersionTable.OS
		}
	}
    if ($os -match "Windows") {
		if (Test-OsRelease -and -not $skipOSR) {
			$os = "Linux"
		} else {
			$caption = $script:osInfo.Caption
			if ($caption -match "Windows 11") { return "win11_fetch" }
			elseif ($caption -match "Windows 10") { return "win10_fetch" }
			else { return "win_fetch" }
		}
    }
    if ($os -match "Linux") {
        if (-not (Test-Path /etc/os-release)) {
            return "tux"
        }
        $osInfo = Get-Content /etc/os-release | ConvertFrom-StringData
        $id = $osInfo.ID.ToLower()
        $ResolvedOSK = switch ($id) {
			"fedora"    {"fedora"}
            "arch"        { "arch" } # btw
			"nyarch"    { "nyarch" } # ntw
			"artix"      { "artix" } # btw
            "linuxmint" { "mint" }
            "debian"    { "debian" }
            "lesbian"    { "lesbian" }
            "cerealos"    { "cerealos" } # **my** operating system??
            "ubuntu"    { "ubuntu" }
			"uwuntu"    { "uwuntu" }
            "pop"       { "pop" }
			"android" { "android" }
			"amogos" { "amogos" }
			"alpine" { "alpine" }
			"opensuse-leap" { "opensuse" }
			"opensuse-tumbleweed" { "opensuse_butter" }
			"gentoo" { "gentoo" }
			"neon" { "kde_neon" }
			"zorin" {"zorin"}
			"elementary" {"elementary"}
			"manjaro" {"manjaro"}
			"kali" {"kali"}
			"raspbian" {"raspbian"}
			"windows" {"win11_fetch"}
			"winmeows" {"winmeows"}
			"macos" {"mac"}
			"cachyos" {"cachy"}	
			"endeavouros" {"endeavour"}	
			"postmarketos" {"postmarket"}
            default      { "tux" }
        }
		if ($ResolvedOSK -ne "tux") {
			return $ResolvedOSK
		} else {
			$pretty_name = $osInfo.PRETTY_NAME.ToLower()
			$ResolvedOSK = switch ($true) {
				($pretty_name -match "fedora")     {"fedora"}
				($pretty_name -match "arch")       { "arch" } # btw
				($pretty_name -match "nyarch")     { "nyarch" } # ntw
				($pretty_name -match "artix")      { "artix" } # btw
				($pretty_name -match "linux mint") { "mint" }
				($pretty_name -match "debian")     { "debian" }
				($pretty_name -match "lesbian")    { "lesbian" }
				($pretty_name -match "cerealos")    { "cerealos" } # **my** operating system??
				($pretty_name -match "ubuntu")    { "ubuntu" }
				($pretty_name -match "uwuntu")    { "uwuntu" }
				($pretty_name -match "pop")       { "pop" }
				($pretty_name -match "android") { "android" }
				($pretty_name -match "amogos") { "amogos" }
				($pretty_name -match "alpine") { "alpine" }
				($pretty_name -match "opensuse leap") { "opensuse" }
				($pretty_name -match "opensuse tumbleweed") { "opensuse_butter" }
				($pretty_name -match "gentoo") { "gentoo" }
				($pretty_name -match "kde neon") { "kde_neon" }
				($pretty_name -match "zorin") {"zorin"}
				($pretty_name -match "elementary") {"elementary"}
				($pretty_name -match "manjaro") {"manjaro"}
				($pretty_name -match "kali") {"kali"}
				($pretty_name -match "raspbian") {"raspbian"}
				($pretty_name -match "rasperry") {"rasperry"}
				($pretty_name -match "cachy") {"cachy"}
				($pretty_name -match "endeavour") {"endeavour"}
				($pretty_name -match "postmarket") {"postmarket"}
				default      { "tux" }
			}
		}
		if ($ResolvedOSK -ne "tux") {
			return $ResolvedOSK
		} else {
			$PSOS = $PSVersionTable.os
			$ResolvedOSK = switch ($true) {
				($PSOS -match "fedora")     {"fedora"}
				($PSOS -match "arch")       { "arch" } # btw
				($PSOS -match "nyarch")     { "nyarch" } # ntw
				($PSOS -match "artix")      { "artix" } # btw
				($PSOS -match "linux mint") { "mint" }
				($PSOS -match "debian")     { "debian" }
				($PSOS -match "lesbian")    { "lesbian" }
				($PSOS -match "cerealos")    { "cerealos" } # **my** operating system??
				($PSOS -match "ubuntu")    { "ubuntu" }
				($PSOS -match "uwuntu")    { "uwuntu" }
				($PSOS -match "pop")       { "pop" }
				($PSOS -match "android") { "android" }
				($PSOS -match "amogos") { "amogos" }
				($PSOS -match "alpine") { "alpine" }
				($PSOS -match "opensuse leap") { "opensuse" }
				($PSOS -match "opensuse tumbleweed") { "opensuse_butter" }
				($PSOS -match "gentoo") { "gentoo" }
				($PSOS -match "kde neon") { "kde_neon" }
				($PSOS -match "zorin") {"zorin"}
				($PSOS -match "elementary") {"elementary"}
				($PSOS -match "manjaro") {"manjaro"}
				($PSOS -match "kali") {"kali"}
				($PSOS -match "raspbian") {"raspbian"}
				($PSOS -match "rasperry") {"rasperry"}
				($PSOS -match "cachy") {"cachy"}
				($PSOS -match "endeavour") {"endeavour"}
				($PSOS -match "postmarket") {"postmarket"}
				default      { "tux" }
			}
		}
		if ($ResolvedOSK -ne "tux") {
			return $ResolvedOSK
		} else {
			$id_like = $osInfo.ID_LIKE.ToLower()
			$ResolvedOSK = switch ($id_like) {
				"fedora"    {"fedora"}
				"arch"        { "arch" } # btw
				"debian"    { "debian" }
				"cerealos"    { "cerealos" } # **my** operating system??
				"ubuntu"    { "ubuntu" }
				"android" { "android" }
				"alpine" { "alpine" }
				"suse" { "opensuse" }
				"gentoo" { "gentoo" }
				"kali" {"kali"}
				"windows" {"win11_fetch"}
				default      { "tux" }
			}
		}
		return $ResolvedOSK
    }
    elseif ($os -match "Darwin") {
        return "mac"
    }
	elseif ($os -match "UNIX") {
		return "unix"
	}
    return "fetch_unknown_os"
}
function lesbian{
	if ((random 1 100) -eq 1) {
		return "lesbian"
	} else {
		return "debian"
	}
}

function resolveOSC($OSin) {
	if($OSin -eq "arch" -or $OSin -eq "winmeows" -or $OSin -eq "win11_fetch" -or $OSin -eq "windows_11" -or $OSin -eq "artix" -or $OSin -eq "fedora" -or $OSin -eq "alpine" -or $OSin -eq "nyarch" -or $OSin -eq "zorin" -or $OSin -eq "kali") {
		return $($color.win11)
	} elseif ($OSin -eq "win10_fetch" -or $OSin -eq "win_fetch" -or $OSin -eq "windows" -or $OSin -eq "windows_10" -or $OSin -eq "discord" -or $OSin -eq "endeavour") {
		return $($color.win10)
	} elseif ($OSin -eq "mint" -or $OSin -eq "postmarket" -or $OSin -eq "android" -or $OSin -eq "opensuse" -or $OSin -eq "opensuse_leap" -or $OSin -eq "kde_neon" -or $OSin -eq "neon" -or $OSin -eq "linux_mint" -or $OSin -eq "manjaro") {
		return $($color.mint)
	} elseif ($OSin -eq "pop") {
		return $($color.pop)
	} elseif ($OSin -eq "ubuntu") {
		return $($color.orange)
	} elseif ($OSin -eq "debian" -or $OSin -eq "raspbian" -or $OSin -eq "raspberry" -or $OSin -eq "pi") {
		return $($color.debian)
	} elseif ($OSin -eq "mac") {
		return ($($color.cyan)) 
	} elseif ($OSin -eq "cerealos") {
		return ($($color.pink))
	} elseif ($OSin -eq "amogos") {
		return ($($color.red))
	} elseif ($OSin -eq "gentoo") {
		return ($($color.lunar))
	} elseif ($OSin -eq "opensuse_butter" -or $OSin -eq "opensuse_tumbleweed") {
		return ($($color.butter))
	} elseif ($OSin -eq "lesbian") {
		return $($color.lesbian4)
	} elseif ($OSin -eq "elementary") {
		return ""
	} elseif ($OSin -eq "uwuntu") {
		return $($color.cereal)
	} elseif ($OSin -eq "cachy") {
		return ($($color.cachy))
	} elseif($OSin -eq "linux" -or $OSin -eq "tux") {
		return $($color.lightgray)
	} else {
		return ($($color.violet))
	}
}

