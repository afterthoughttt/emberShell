                ████████████████████████████████                
                                                                
         ███    ████████████████████████████████    ███         
       ███████  ████████████████████████████████  ███████       
       ███████  ████████████████████████████████  ███████       
       ███████  ████████████████████████████████  ███████       
       ███████  ████████████████████████████████  ███████       
       ███████  ████████████████████████████████  ███████       
       ███████  ████████████████████████████████  ███████       
       ███████  ████████████████████████████████  ███████       
       ███████  ████████████████████████████████  ███████       
       ███████  ████████████████████████████████  ███████       
       ███████  ████████████████████████████████  ███████       
       ███████  ████████████████████████████████  ███████       
                ████████████████████████████████                
                ████████████████████████████████                
                ████████████████████████████████                
                 ██████████████████████████████                 
                      ███████      ███████                      
                      ███████      ███████                      
                      ███████      ███████                      
                      ███████      ███████                      
                      ███████      ███████                      
                      ███████      ███████                      
                        ███          ███
		$($color.reset)"
	} elseif($type -eq "amogos") {
		write-output "$($color.red)
			    ███
			   ██$($color.reset)$($color.cyan)██$($color.reset)
			   $($color.red)████
			    █ █$($color.reset)"
	} elseif($type -eq "uwuntu") {
	write-output "$($color.lesbian3)
	                                  ██
                               ████████
   █                  █████████  ████████
    ████████     ████████████████  █████
     ██$($color.lesbian3)████████$($color.cereal)████   █████████████████   ████████████████████
     ████$($color.lesbian3)██████████$($color.cereal)████   █        ████████$($color.lesbian3)████████████$($color.cereal)██
      ████████$($color.lesbian3)████$($color.cereal)████               ████$($color.lesbian3)████████$($color.cereal)████
       ████████$($color.lesbian3)████$($color.cereal)██                  ████$($color.lesbian3)████████$($color.cereal)████
    ████  ████████$($color.lesbian4)█$($color.cereal)█                    █$($color.lesbian4)█$($color.cereal)█████
 ████████████  ████$($color.lesbian4)█$($color.cereal)███                █$($color.lesbian4)█$($color.cereal)
 ████████████  ███$($color.lesbian4)█$($color.cereal)███      $($color.lesbian4)█    █$($color.cereal)      ██$($color.lesbian4)█$($color.cereal)████████
   █████████████████      $($color.lesbian4)███████$($color.cereal)      █████████
        █████████████████              █████████████
           ████████████           █████████████
            ████████    █████████████
            $($color.lesbian3)████$($color.cereal)  █   ████████████████  ████████
           $($color.lesbian3)██████$($color.cereal)        █████████   █████████████
 $($color.lesbian3)██████     ████$($color.cereal)                     ████████
$($color.lesbian3)███      ██████$($color.cereal)
  $($color.lesbian3)████████████$($color.reset)`n"
  } else {
		if(-not $fwd) {
			watermark $type -fwd
		} else {
			softthrow "no watermark of that name found"
		}
	}
}

function clib([switch]$version, [switch]$fork, [switch]$dev, [switch]$vername, [switch]$libname, [switch]$esx) {
	if($libname){
		if($clibManifest.fork -eq $false) {
			watermark clib
		} else {
			write-output $($clibManifest).lib_name
		}
	}
	if($version){
		write-output $($clibManifest).version
	}
	if($vername){
		write-output $($clibManifest).ver_name
	}
	if($dev){
		write-output "by" $($clibManifest).dev_name
	}
	if($fork){
		if($clibManifest.fork -eq $true){
			write-output "is a fork"
		}else{
			write-output "not a fork"
		}
	}
	if($esx){
		if($clibManifest.esx -eq $true){
			write-output "esx build"
		}else{
			write-output "psm1 build"
		}
	}
}

function cdump {
$order = @('black','darkgray','gray','lightgray','white','afterthought','debian','lesbian1','red','orange','lesbian2','yellow','butter','mint','green','cyan','pop','win11','aletheia','win10','efas','blue','indigo','violet','lesbian4','pink','lesbian3','cereal','lunar')
$line = ""
$i = 0
foreach ($name in $order) {
    $c = $color[$name]
    if (-not $c) { continue }
    $bg = $c -replace '\[38;', '[48;'
    $line += "$bg  $($color.reset)"
    $i++
    if ($i % 16 -eq 0) {
        $line += "`n"
    }
}
Write-Host $line
}

function Get-OSKey {
    $os = [System.Runtime.InteropServices.RuntimeInformation]::OSDescription
    if ($os -match "Windows") {
        $caption = (Get-CimInstance Win32_OperatingSystem).Caption
        if ($caption -match "Windows 11") { return "win11_fetch" }
        elseif ($caption -match "Windows 10") { return "win10_fetch" }
        else { return "win_fetch" }
    }
    elseif ($os -match "Linux") {
        if (-not (Test-Path /etc/os-release)) {
            return "tux"
        }
        $osInfo = Get-Content /etc/os-release | ConvertFrom-StringData
        $id = $osInfo.ID.ToLower()
        switch ($id) {
			"fedora"    {return "fedora"}
            "arch"        { return "arch" } # btw
			"nyarch"    { return "nyarch" } # ntw
			"artix"      { return "artix" } # btw
            "linuxmint" { return "mint" }
            "debian"    { return "debian" }
            "lesbian"    { return "lesbian" }
            "cerealos"    { return "cerealos" } # **my** operating system??
            "ubuntu"    { return "ubuntu" }
			"uwuntu"    { return "uwuntu" }
            "pop"       { return "pop" }
			"android" { return "android" }
			"amogos" { return "amogos" }
			"alpine" { return "alpine" }
			"opensuse-leap" { return "opensuse" }
			"opensuse-tumbleweed" { return "opensuse_butter" }
			"gentoo" { return "gentoo" }
			"neon" { return "kde_neon" }
			"zorin" {return "zorin"}
			"elementary" {return "elementary"}
            default      { return "tux" }
        }
    }
    elseif ($os -match "Darwin") {
        return "mac"
    }
    return "fetch_unknown_os"
}
function lesbian{
	if ((random 1 100) -eq 1) {
		return "lesbian"
	} else {
		return "debian"
	}
}

function resolveOSC($OSin) {
	if($OSin -eq "arch" -or $OSin -eq "win11_fetch" -or $OSin -eq "windows_11" -or $OSin -eq "artix" -or $OSin -eq "fedora" -or $OSin -eq "alpine" -or $OSin -eq "nyarch" -or $OSin -eq "zorin") {
		return $($color.win11)
	} elseif ($OSin -eq "win10_fetch" -or $OSin -eq "win_fetch" -or $OSin -eq "windows" -or $OSin -eq "windows_10") {
		return $($color.win10)
	} elseif ($OSin -eq "mint" -or $OSin -eq "android" -or $OSin -eq "opensuse" -or $OSin -eq "opensuse_leap" -or $OSin -eq "kde_neon" -or $OSin -eq "neon" -or $OSin -eq "linux_mint") {
		return $($color.mint)
	} elseif ($OSin -eq "pop") {
		return $($color.pop)
	} elseif ($OSin -eq "tux" -or $OSin -eq "ubuntu" -or $OSin -eq "linux") {
		return $($color.orange)
	} elseif ($OSin -eq "debian") {
		return $($color.debian)
	} elseif ($OSin -eq "mac") {
		return ($($color.cyan)) 
	} elseif ($OSin -eq "cerealos") {
		return ($($color.pink))
	} elseif ($OSin -eq "amogos") {
		return ($($color.red))
	} elseif ($OSin -eq "gentoo") {
		return ($($color.lunar))
	} elseif ($OSin -eq "opensuse_butter" -or $OSin -eq "opensuse_tumbleweed") {
		return ($($color.butter))
	} elseif ($OSin -eq "lesbian") {
		return $($color.lesbian4)
	} elseif ($OSin -eq "elementary") {
		return ""
	} elseif ($OSin -eq "uwuntu") {
		return $($color.cereal)
	} else {
		return ($($color.violet))
	}
}

$validOSes = @(
"win_fetch", "windows",
"win10_fetch", "windows_10",
"win11_fetch", "windows_11",
"arch",
"mint", "linux_mint"
"pop",
"tux", "linux"
"ubuntu",
"debian",
"mac",
"cerealos",
"fedora",
"artix",
"android",
"amogos",
"alpine",
"nyarch",
"gentoo",
"opensuse", "opensuse_leap",
"opensuse_butter", "opensuse_tumbleweed",
"lesbian",
"kde_neon", "neon"
"elementary",
"zorin",
"uwuntu"
)
function cfetch($larp) {
	if ($larp) {
		$resolvedosc = resolveOSC($larp)
		if ($larp -notin $validOSes) {
			render "fetch_unknown_os"
		} else {
			render $larp
		}
		if ($larp -eq "win_fetch" -or $larp -eq "windows") {
			write-output "$($resolvedosc)OS:          Windows"
		} elseif ($larp -eq "win10_fetch" -or $larp -eq "windows_10") {
			write-output "$($resolvedosc)OS:          Windows 10"
		} elseif ($larp -eq "win11_fetch" -or $larp -eq "windows_11") {
			write-output "$($resolvedosc)OS:          Windows 11"
		} elseif ($larp -eq "arch") {
			write-output "$($resolvedosc)OS:          Arch" # btw
		} elseif ($larp -eq "mint" -or $larp -eq "linux_mint") {
			write-output "$($resolvedosc)OS:          Linux Mint"
		} elseif ($larp -eq "debian") {
			write-output "$($resolvedosc)OS:          Debian"
		} elseif ($larp -eq "pop") {
			write-output "$($resolvedosc)OS:          Pop!_OS"
		} elseif ($larp -eq "tux" -or $larp -eq "linux") {
			write-output "$($resolvedosc)OS:          Linux"
		} elseif ($larp -eq "ubuntu") {
			write-output "$($resolvedosc)OS:          Ubuntu"
		} elseif ($larp -eq "mac") {
			write-output "$($resolvedosc)OS:          MacOS"
		} elseif ($larp -eq "cerealos") {
			write-output "$($resolvedosc)OS:          CerealOS"
		} elseif ($larp -eq "artix") {
			write-output "$($resolvedosc)OS:          Artix"
		} elseif ($larp -eq "fedora") {
			write-output "$($resolvedosc)OS:          Fedora"
		} elseif ($larp -eq "android") {
			write-output "$($resolvedosc)OS:          Android"
		} elseif ($larp -eq "amogos") {
			write-output "$($resolvedosc)OS:          AmogOS"
		} elseif ($larp -eq "alpine") {
			write-output "$($resolvedosc)OS:          Alpine"
		} elseif ($larp -eq "nyarch") {
			write-output "$($resolvedosc)OS:          Nyarch"
		} elseif ($larp -eq "gentoo") {
			write-output "$($resolvedosc)OS:          Gentoo"
		} elseif ($larp -eq "opensuse" -or $larp -eq "opensuse_leap") {
			write-output "$($resolvedosc)OS:          openSUSE"
		} elseif ($larp -eq "opensuse_butter" -or $larp -eq "opensuse_tumbleweed") {
			write-output "$($resolvedosc)OS:          openSUSE"
		} elseif ($larp -eq "lesbian") {
			write-output "$($resolvedosc)OS:          Lesbian"
		} elseif ($larp -eq "kde_neon" -or $larp -eq "neon") {
			write-output "$($resolvedosc)OS:          KDE Neon"
		} elseif ($larp -eq "elementary") {
			write-output "$($resolvedosc)OS:          ElementaryOS"
		} elseif ($larp -eq "zorin") {
			write-output "$($resolvedosc)OS:          Zorin OS"
		} elseif ($larp -eq "uwuntu") {
			write-output "$($resolvedosc)OS:          UwUntu"
		} else { 
			write-output "$($resolvedosc)OS:          $larp"
		}
	} else {
		$logo = Get-OSKey
		if($logo -eq "debian") {
			$logo = lesbian
		}
		$resolvedosc = resolveOSC($logo)
		if ($logo -notin $validOSes) {
			render "fetch_unknown_os"
		} else {
			render $logo
		}
		if ($logo -eq "win_fetch") {
			write-output "$($resolvedosc)OS:          Windows"
		} elseif ($logo -eq "win10_fetch") {
			write-output "$($resolvedosc)OS:          Windows 10"
		} elseif ($logo -eq "win11_fetch") {
			write-output "$($resolvedosc)OS:          Windows 11"
		} elseif ($logo -eq "arch") {
			write-output "$($resolvedosc)OS:          Arch" # btw
		} elseif ($logo -eq "mint") {
			write-output "$($resolvedosc)OS:          Linux Mint"
		} elseif ($logo -eq "debian") {
			write-output "$($resolvedosc)OS:          Debian"
		} elseif ($logo -eq "pop") {
			write-output "$($resolvedosc)OS:          Pop!_OS"
		} elseif ($logo -eq "tux") {
			write-output "$($resolvedosc)OS:          Linux"
		} elseif ($logo -eq "ubuntu") {
			write-output "$($resolvedosc)OS:          Ubuntu"
		} elseif ($logo -eq "mac") {
			write-output "$($resolvedosc)OS:          MacOS"
		} elseif ($logo -eq "artix") {
			write-output "$($resolvedosc)OS:          Artix"
		} elseif ($logo -eq "fedora") {
			write-output "$($resolvedosc)OS:          Fedora"
		} elseif ($logo -eq "android") {
			write-output "$($resolvedosc)OS:          Android"
		} elseif ($logo -eq "amogos") {
			write-output "$($resolvedosc)OS:          AmogOS"
		} elseif ($logo -eq "alpine") {
			write-output "$($resolvedosc)OS:          Alpine"
		} elseif ($logo -eq "nyarch") {
			write-output "$($resolvedosc)OS:          Nyarch"
		} elseif ($logo -eq "gentoo") {
			write-output "$($resolvedosc)OS:          Gentoo"
		} elseif ($logo -eq "opensuse") {
			write-output "$($resolvedosc)OS:          openSUSE"
		} elseif ($logo -eq "opensuse_butter") {
			write-output "$($resolvedosc)OS:          openSUSE"
		} elseif ($logo -eq "lesbian") {
			write-output "$($resolvedosc)OS:          Lesbian"
		} elseif ($logo -eq "cerealos") {
			write-output "$($resolvedosc)OS:          CerealOS"
		} elseif ($logo -eq "kde_neon" -or $logo -eq "neon") {
			write-output "$($resolvedosc)OS:          KDE Neon"
		} elseif ($logo -eq "elementary") {
			write-output "$($resolvedosc)OS:          ElementaryOS"
		} elseif ($logo -eq "zorin") {
			write-output "$($resolvedosc)OS:          Zorin OS"
		} elseif ($logo -eq "uwuntu") {
			write-output "$($resolvedosc)OS:          UwUntu"
		} else {
			if ($IsWindows -or (Get-CimInstance Win32_OperatingSystem -ErrorAction SilentlyContinue)) {
				render win_fetch
				write-host "$(Get-CimInstance Win32_OperatingSystem)"
			} elseif ($IsMac) {
				render mac
				resolveOSC("mac")
				write-output "$($resolvedosc)OS:          MacOS"
			} elseif ($IsLinux) {
				render tux
				resolveOSC("tux")
				write-output "$($resolvedosc)OS:          Linux"
			} else {
				write-output "$($resolvedosc)OS:          Unknown" # TempleOS or some shit right here
			}
		}
	}
	if ($IsWindows -or (Get-CimInstance Win32_OperatingSystem -ErrorAction SilentlyContinue)) {
		$cpu = get-ciminstance Win32_Processor
		Write-Output "$($resolvedosc)CPU:         $($cpu.Name)"
		Write-Output "$($resolvedosc)CPU Base:    $($cpu.MaxClockSpeed)MHz"
		Write-Output "$($resolvedosc)CPU Cores:   $($cpu.NumberOfCores)"
		Write-Output "$($resolvedosc)CPU Threads: $($cpu.NumberOfLogicalProcessors)"
		Write-Output "$($resolvedosc)GPU:         $((get-ciminstance Win32_VideoController).Name)"
		$ram = get-ciminstance Win32_PhysicalMemory
		$total = ($ram | Measure-Object -Property Capacity -Sum).Sum / 1GB
		$speed = $ram[0].Speed
		$gen = switch ($ram[0].SMBIOSMemoryType) {
			18 { "DDR" }
			19 { "DDR2" }
			20 { "DDR2 FB-DIMM" }
			24 { "DDR3" }
			25 { "FBD2" }
			26 { "DDR4" }
			27 { "LPDDR" }
			28 { "LPDDR2" }
			29 { "LPDDR3" }
			30 { "LPDDR4" }
			31 { "LPDDR4X" }
			32 { "DDR5" }
			33 { "LPDDR5" }
			34 { "DDR5" }
			35 { "LPDDR5X" }
			default { "DDR?" }
		}
		Write-Output "$($resolvedosc)RAM:         $($total)GB $($gen) $($speed)MT/s"
		$disks = Get-PhysicalDisk | Sort-Object DeviceId
		$prefix = "$($resolvedosc)Storage:     "
		$indent = " " * $prefix.Length
		Write-Host -NoNewline $prefix
		$first = $true
		foreach ($disk in $disks) {
			$size = $disk.Size
			$sizeStr = if ($size -ge 1000000000000) { "$([math]::Round($size / 1000000000000, 1))TB" }
        else { "$([math]::Round($size / 1000000000))GB" }
			$bus = $disk.BusType
			$type = $disk.MediaType
			$label = if ($bus -eq "NVMe") { "NVMe SSD" }
					 elseif ($bus -eq "USB") { "USB Drive" }
					 elseif ($type -eq "SSD") { "SATA SSD" }
					 elseif ($type -eq "HDD") { "HDD" }
					 elseif ($bus -eq "ATAPI") { "Disc Drive" }
					 else { "$bus $type".Trim() }
			if ($first) {
				Write-Output "$($resolvedosc)$sizeStr $label"
				$first = $false
			} else {
				Write-Output "$($resolvedosc)$indent$sizeStr $label"
			}
		}
		$mobo = get-ciminstance Win32_BaseBoard
		$moboStr = "$($mobo.Manufacturer) $($mobo.Product)".Trim()
		Write-Output "$($resolvedosc)Motherboard: $($mobo.Manufacturer) $($mobo.Product)"
		$uptime = (Get-Date) - (gcim Win32_OperatingSystem).LastBootUpTime
		Write-Output "$($resolvedosc)Uptime:      $($uptime.Days)d $($uptime.Hours)h $($uptime.Minutes)m$($color.reset)"
	} elseif ($IsLinux) {
		$cpu = (lscpu | Select-String "Model name").ToString().Split(":")[1].Trim()
		Write-Output "$($resolvedosc)CPU:         $cpu"
		$mhzLine = lscpu | Select-String "CPU max MHz"
		if (-not $mhzLine) { $mhzLine = lscpu | Select-String "CPU MHz" }
		if ($mhzLine) {
			$base = [math]::Round([double]($mhzLine.Line.Split(":")[1].Trim()))
			Write-Output "$($resolvedosc)CPU Base:    ${base}MHz"
		} else {
			$freqPath = "/sys/devices/system/cpu/cpu0/cpufreq/base_frequency"
			$freqFallback = "/sys/devices/system/cpu/cpu0/cpufreq/cpuinfo_max_freq"
			if (Test-Path $freqPath) {
				$base = [math]::Round((Get-Content $freqPath) / 1000)
				Write-Output "$($resolvedosc)CPU Base:    ${base}MHz"
			} elseif (Test-Path $freqFallback) {
				$base = [math]::Round((Get-Content $freqFallback) / 1000)
				Write-Output "$($resolvedosc)CPU Base:    ${base}MHz"
			} else {
				Write-Output "$($resolvedosc)CPU Base:    failed to fetch"
			}
		}
		$cores = (nproc)
		$threads = (lscpu | Select-String "^CPU\(s\):").ToString().Split(":")[1].Trim()
		Write-Output "$($resolvedosc)CPU Cores:   $cores"
		Write-Output "$($resolvedosc)CPU Threads: $threads"
		$gpuLine = lspci | Select-String -Pattern "VGA|3D" | Select-Object -First 1
		if ($gpuLine) {
			$gpu = $gpuLine.ToString().Split(":")[2].Trim()
			Write-Output "$($resolvedosc)GPU:         $gpu"
		} else {
			Write-Output "$($resolvedosc)GPU:         failed to fetch"
		}
		$memKb = (Get-Content /proc/meminfo | Where-Object { $_ -match '^MemTotal' }) -replace '[^0-9]'
		$ramGb = [long]$memKb / 1024 / 1024
		$sizeStr = if ($ramGb -ge 1) { "$([math]::Round($ramGb))GB" } else { "$([math]::Round($ramGb * 1024))MB" }
		$dmiRaw = $null
		if (Get-Command dmidecode -ErrorAction SilentlyContinue) {
			$dmiRaw = dmidecode -t 17 2>/dev/null
			if ($LASTEXITCODE -ne 0) { $dmiRaw = $null }
		}
		if ($dmiRaw) {
			$type  = $dmiRaw | Select-String "^\s*Type:"  | Select-Object -First 1 | ForEach-Object { ($_ -split ":\s*")[1].Trim() }
			$speed = $dmiRaw | Select-String "^\s*Speed:" | Select-Object -First 1 | ForEach-Object { ($_ -split ":\s*")[1].Trim() }
			Write-Output "$($resolvedosc)RAM:         $sizeStr $type $speed"
		} else {
		Write-Output "$($resolvedosc)RAM:         $sizeStr"
		}
		$disks = lsblk -dn -o NAME,SIZE,ROTA --bytes | Where-Object { $_ -match "^\s*(sd[a-z]|nvme|vd|hd)" }
		$prefix = "Storage:     "
		$indent = " " * $prefix.Length
		$first = $true
		foreach ($d in $disks) {
			$parts = $d -split "\s+" | Where-Object { $_ -ne "" }
			$name  = $parts[0]
			$bytes = [long]$parts[1]
			$rota  = $parts[2]
			$sizeStr = if ($bytes -ge 1000000000000) { "$([math]::Round($bytes / 1000000000000, 1))TB" }
            elseif ($bytes -ge 1000000000) { "$([math]::Round($bytes / 1000000000))GB" }
            else { "$([math]::Round($bytes / 1000000))MB" }
			$label = if ($name -match "^nvme") { "NVMe SSD" }
            elseif ($name -match "^sd" -and $rota -eq "0") { "SATA SSD" }
            elseif ($rota -eq "1") { "HDD" }
            else { "SSD" }
			$line = if ($first) { $prefix } else { $indent }
			Write-Output "$($resolvedosc)$line$sizeStr $label"
			$first = $false
		}
		if (Test-Path "/sys/class/dmi/id/board_vendor") {
			$vendor = Get-Content /sys/class/dmi/id/board_vendor
			$name = Get-Content /sys/class/dmi/id/board_name
			Write-Output "$($resolvedosc)Motherboard: $vendor $name"
		} else {
			Write-Output "$($resolvedosc)Motherboard: failed to fetch"
		}
		$raw = [double](Get-Content /proc/uptime).Split()[0]
		$ts = [timespan]::FromSeconds($raw)
		$parts = @()
		if ($ts.Days)    { $parts += "$($ts.Days)d" }
		if ($ts.Hours)   { $parts += "$($ts.Hours)h" }
		if ($ts.Minutes) { $parts += "$($ts.Minutes)m" }
		$uptime = if ($parts) { $parts -join " " } else { "0m" }
		Write-Output "$($resolvedosc)Uptime:      $uptime"
		# write-output "cfetch is untested on Linux.`nvalues may be innacurate."
	} elseif($IsMacOS) {
		write-output "cfetch is untested on MacOS.`nrunning it may cause issues or report false system information.`nrun anyways?`n$($color.green)y$($color.reset)/$($color.red)n$($color.reset)"
		$yn = (confirm "runanyways" "y" "n")
		if($yn) {
			$cpu = sysctl -n machdep.cpu.brand_string
			$cores = sysctl -n hw.physicalcpu
			$threads = sysctl -n hw.logicalcpu
			Write-Output "$($resolvedosc)CPU:         $cpu"
			Write-Output "$($resolvedosc)CPU Cores:   $cores"
			Write-Output "$($resolvedosc)CPU Threads: $threads"
			Write-Output "$($resolvedosc)CPU Base:    unsupported on macos"
			$ram = (sysctl -n hw.memsize) / 1GB
			Write-Output "$($resolvedosc)RAM:         $([math]::Round($ram,1))GB"
			Write-Output "$($resolvedosc)RAM Detail:  unsupported on macos"
			$gpuLine = system_profiler SPDisplaysDataType | Select-String "Chipset Model" | Select-Object -First 1
			if ($gpuLine) {
				$gpu = $gpuLine.ToString().Split(":")[1].Trim()
				Write-Output "$($resolvedosc)GPU:         $gpu"
			} else {
				Write-Output "$($resolvedosc)GPU:         unsupported on macos"
			}
			$disk = (df -h / | Select-Object -Last 1).Split()[1]
			Write-Output "$($resolvedosc)Storage:     $disk"
			Write-Output "$($resolvedosc)Storage Type: unsupported on macos"
			Write-Output "$($resolvedosc)Motherboard: unsupported on macos"
			$uptimeRaw = uptime
			$uptime = (($uptimeRaw -split "up ")[1] -split ",")[0]
			Write-Output "$($resolvedosc)Uptime:      $uptime"
		}
	}
	cdump
}

Export-ModuleMember -Variable color
Export-ModuleMember -Variable time
Export-ModuleMember -Variable esc
Export-ModuleMember -Function *

