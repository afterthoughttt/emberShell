$script:psget_count = 0
function lspkg([switch]$winget, [switch]$langpkgs) {
    $jobs = @{}

    if ($IsWindows -or ($PSVersionTable.PSEdition -eq "Desktop") -or (!$IsLinux -and !$IsMacOS)) {
        if ($winget -and (gcm winget -ea silentlycontinue)) {
            $jobs['winget'] = Start-Job {
                $raw = winget list --disable-interactivity --accept-source-agreements 2>$null
                ($raw | Where-Object { $_ -match '\S' }).Count - 2
            }
        }
        if (gcm scoop -ea silentlycontinue) {
            $jobs['scoop'] = Start-Job { (ls "$env:USERPROFILE\scoop\apps" -di 2>$null).Count - 1 }
        }
        if (gcm choco -ea silentlycontinue) {
            $jobs['choco'] = Start-Job {
                $raw = choco list 2>$null
                if ($raw[-1] -match '(\d+) packages? installed') { [int]$Matches[1] } else { 0 }
            }
        }
        if (gcm cpkg -ea silentlycontinue) {
            $script:cpkg_count = cpkg c -n
        }
        if (Test-Path C:\msys64\usr\bin\bash.exe) {
            $jobs['pacman'] = Start-Job { (& C:\msys64\usr\bin\bash.exe --login -c "pacman -Q" | Measure-Object -Line).Lines }
        }
        if ($langpkgs) {
            if (gcm npm -ea silentlycontinue)    { $jobs['npm']    = Start-Job { npm list -g 2>$null | Select-Object -Skip 1 | Measure-Object -Line | Select-Object -ExpandProperty Lines } }
            if (gcm pip -ea silentlycontinue)    { $jobs['pip']    = Start-Job { pip list 2>$null | Select-Object -Skip 2 | Measure-Object -Line | Select-Object -ExpandProperty Lines } }
            if (gcm cargo -ea silentlycontinue)  { $jobs['cargo']  = Start-Job { (cargo install --list 2>$null | Measure-Object -Line | Select-Object -ExpandProperty Lines) / 2 } }
            if (gcm gem -ea silentlycontinue)    { $jobs['gem']    = Start-Job { gem list 2>$null | Measure-Object -Line | Select-Object -ExpandProperty Lines } }
            if (gcm luarocks -ea silentlycontinue) { $jobs['luarocks'] = Start-Job { luarocks list 2>$null | Where-Object { $_ -match "^\w" -and $_ -notmatch "^Rocks" -and $_ -notmatch "^---" } | Measure-Object -Line | Select-Object -ExpandProperty Lines } }
            if (gcm Get-InstalledPSResource -ea silentlycontinue) { $jobs['psget_resource'] = Start-Job { Get-InstalledPSResource 2>$null | Measure-Object | Select-Object -ExpandProperty Count } }
            if (gcm Get-InstalledModule -ea silentlycontinue)     { $jobs['psget_module']   = Start-Job { Get-InstalledModule 2>$null | Measure-Object | Select-Object -ExpandProperty Count } }
        }
    }

    if ($IsLinux) {
        if (gcm dpkg-query -ea silentlycontinue)  { $jobs['apt']       = Start-Job { (dpkg-query -f '.\n' -W 2>$null).Count } }
        if (gcm pacman -ea silentlycontinue)       { $jobs['pacman']    = Start-Job { (pacman -Qq 2>$null).Count } }
        if (gcm rpm -ea silentlycontinue)          { $jobs['rpm']       = Start-Job { (rpm -qa 2>$null).Count } }
        if (gcm zypper -ea silentlycontinue)       { $jobs['zypper']    = Start-Job { (zypper se --installed-only 2>$null).Count - 5 } }
        if (gcm flatpak -ea silentlycontinue)      { $jobs['flatpak']   = Start-Job { (flatpak list 2>$null).Count - 1 } }
        if (gcm snap -ea silentlycontinue)         { $jobs['snap']      = Start-Job { (snap list 2>$null).Count - 1 } }
        if (gcm brew -ea silentlycontinue)         { $jobs['brew']      = Start-Job { (brew list 2>$null).Count } }
        if (gcm nix-env -ea silentlycontinue)      { $jobs['nix']       = Start-Job { (nix-env -q 2>$null).Count } }
        if (gcm xbps-query -ea silentlycontinue)   { $jobs['xbps']      = Start-Job { (xbps-query -l 2>$null).Count } }
        if (gcm apk -ea silentlycontinue)          { $jobs['apk']       = Start-Job { (apk info 2>$null).Count } }
        if (gcm qlist -ea silentlycontinue)        { $jobs['emerge']    = Start-Job { (qlist -I 2>$null).Count } }
        if (gcm opkg -ea silentlycontinue)         { $jobs['opkg']      = Start-Job { (opkg list-installed 2>$null).Count } }
        if (gcm pacstall -ea silentlycontinue)     { $jobs['pacstall']  = Start-Job { (pacstall -L 2>$null).Count } }
        if (gcm port -ea silentlycontinue)         { $jobs['port']      = Start-Job { (port installed 2>$null).Count - 1 } }
        if (gcm pkg -ea silentlycontinue)          { $jobs['pkg']       = Start-Job { (pkg info 2>$null).Count } }
        if (gcm tazpkg -ea silentlycontinue)       { $jobs['tazpkg']    = Start-Job { (tazpkg list 2>$null).Count - 6 } }
        if (gcm equo -ea silentlycontinue)         { $jobs['equo']      = Start-Job { (equo query list installed 2>$null).Count } }
        if (gcm guix -ea silentlycontinue)         { $jobs['guix']      = Start-Job { (guix package -I 2>$null).Count } }
        if (gcm slackpkg -ea silentlycontinue)     { $jobs['slackpkg']  = Start-Job { (Get-ChildItem /var/lib/pkgtools/packages 2>$null).Count } }
        if (gcm cave -ea silentlycontinue)         { $jobs['cave']      = Start-Job { (cave show-install-reasons 2>$null).Count } }
        if (gcm cpkg -ea silentlycontinue)         { $script:cpkg_count = cpkg c -n }
        if ($langpkgs) {
            if (gcm npm -ea silentlycontinue)      { $jobs['npm']       = Start-Job { npm list -g 2>$null | Select-Object -Skip 1 | Measure-Object -Line | Select-Object -ExpandProperty Lines } }
            if (gcm pip -ea silentlycontinue)      { $jobs['pip']       = Start-Job { pip list 2>$null | Select-Object -Skip 2 | Measure-Object -Line | Select-Object -ExpandProperty Lines } }
            elseif (gcm pip3 -ea silentlycontinue) { $jobs['pip']       = Start-Job { pip3 list 2>$null | Select-Object -Skip 2 | Measure-Object -Line | Select-Object -ExpandProperty Lines } }
            if (gcm cargo -ea silentlycontinue)    { $jobs['cargo']     = Start-Job { (cargo install --list 2>$null | Measure-Object -Line | Select-Object -ExpandProperty Lines) / 2 } }
            if (gcm gem -ea silentlycontinue)      { $jobs['gem']       = Start-Job { gem list 2>$null | Measure-Object -Line | Select-Object -ExpandProperty Lines } }
            if (gcm luarocks -ea silentlycontinue) { $jobs['luarocks']  = Start-Job { luarocks list 2>$null | Where-Object { $_ -match "^\w" -and $_ -notmatch "^Rocks" -and $_ -notmatch "^---" } | Measure-Object -Line | Select-Object -ExpandProperty Lines } }
            if (gcm Get-InstalledPSResource -ea silentlycontinue) { $jobs['psget_resource'] = Start-Job { Get-InstalledPSResource 2>$null | Measure-Object | Select-Object -ExpandProperty Count } }
            if (gcm Get-InstalledModule -ea silentlycontinue)     { $jobs['psget_module']   = Start-Job { Get-InstalledModule 2>$null | Measure-Object | Select-Object -ExpandProperty Count } }
        }
    }

    # collect
    $results = @{}
    $jobs.GetEnumerator() | ForEach-Object {
        $results[$_.Key] = Receive-Job $_.Value -Wait -AutoRemoveJob
    }

    # assign
    $script:wget_count    = [int]$results['winget']
    $script:scoop_count   = [int]$results['scoop']
    $script:choco_count   = [int]$results['choco']
    $script:pacman_count  = [int]$results['pacman']
    $script:apt_count     = [int]$results['apt']
    $script:rpm_count     = [int]$results['rpm']
    $script:zypper_count  = [int]$results['zypper']
    $script:flatpak_count = [int]$results['flatpak']
    $script:snap_count    = [int]$results['snap']
    $script:brew_count    = [int]$results['brew']
    $script:nix_count     = [int]$results['nix']
    $script:xbps_count    = [int]$results['xbps']
    $script:apk_count     = [int]$results['apk']
    $script:emerge_count  = [int]$results['emerge']
    $script:opkg_count    = [int]$results['opkg']
    $script:pacstall_count= [int]$results['pacstall']
    $script:port_count    = [int]$results['port']
    $script:pkg_count     = [int]$results['pkg']
    $script:tazpkg_count  = [int]$results['tazpkg']
    $script:equo_count    = [int]$results['equo']
    $script:guix_count    = [int]$results['guix']
    $script:slackpkg_count= [int]$results['slackpkg']
    $script:cave_count    = [int]$results['cave']
    $script:npm_count     = [int]$results['npm']
    $script:pip_count     = [int]$results['pip']
    $script:cargo_count   = [int]$results['cargo']
    $script:gem_count     = [int]$results['gem']
    $script:luarocks_count= [int]$results['luarocks']
    $script:psget_count   = ([int]$results['psget_resource']) + ([int]$results['psget_module'])
}
lspkg

function legacfetch($larp, [switch]$precise, [switch]$bloat, [switch]$clean, [switch]$extra, [switch]$locale, [switch]$diskusage, [switch]$pkgs, [switch]$winget, [switch]$langpkgs, [switch]$backend) { # now thats a LOT of flags.. i know....
if ($IsWindows -or $PSVersionTable.PSEdition -eq "Desktop" -or (!($IsLinux) -and !($IsMacOS))) {
	$script:osInfo = Get-CimInstance Win32_OperatingSystem -ea si
	$swap = Get-CimInstance Win32_PageFileUsage -ea si
	$battery = get-ciminstance Win32_Battery -ea si
	$batteryValueFallback = Get-CimInstance -Namespace ROOT\WMI BatteryStatus -ea si
	$logicalDisks = Get-CIMInstance Win32_LogicalDisk -ea si | Where-Object { $_.DriveType -ne 5 } | Sort-Object DeviceID
}
	if ($winget -or $langpkgs) {
		lspkg -winget:$winget -langpkgs:$langpkgs
	}
	if ($clean) {
		clear
	}
	if ($IsWindows -or $PSVersionTable.PSEdition -eq 'Desktop' -or (!($IsLinux) -and !($IsMacOS))) {
		$dwm = (Get-Item "$env:SystemRoot\System32\dwm.exe").VersionInfo.ProductVersion
		$wm = "Desktop Window Manager"
		$wm_version = $dwm
		$de = ""
		$de_version = ""
		$theme = ""

		$systemLight = Get-ItemPropertyValue -Path "HKCU:\Software\Microsoft\Windows\CurrentVersion\Themes\Personalize" -Name "SystemUsesLightTheme" -ErrorAction SilentlyContinue
		$wm_theme = if ($systemLight -eq 1) { "Light" } else { "Dark" }

		$accentRaw = Get-ItemPropertyValue -Path "HKCU:\Software\Microsoft\Windows\CurrentVersion\Explorer\Accent" -Name "AccentColorMenu" -ErrorAction SilentlyContinue
		if ($accentRaw) {
			$a = [System.BitConverter]::GetBytes([uint32]$accentRaw)
			$accent_color = "#{0:X2}{1:X2}{2:X2}" -f $a[0], $a[1], $a[2]
		} else {
			$accent_color = ""
		}
	} else {
		$de = ""
		$wm = ""
		$wm_version = ""
		$de_version = ""
		$theme = ""
		$accent_color = ""

		if ($env:XDG_CURRENT_DESKTOP) {
			$de = $env:XDG_CURRENT_DESKTOP
		} elseif ($env:DESKTOP_SESSION) {
			$de = $env:DESKTOP_SESSION
		} elseif ($env:XDG_SESSION_DESKTOP) {
			$de = $env:XDG_SESSION_DESKTOP
		}

		if (-not $de) {
			$uid = (& id -u 2>$null)
			$userRun = "/run/user/$uid"
			if (Test-Path "$userRun/KSMserver*" -ErrorAction SilentlyContinue) { $de = "KDE" } # y u have to be this way KDE?
			elseif (Test-Path "$userRun/gnome-session*" -ErrorAction SilentlyContinue) { $de = "GNOME" }
			elseif (Test-Path "$userRun/xfce*" -ErrorAction SilentlyContinue) { $de = "XFCE" }
			elseif (Test-Path "$userRun/mate*" -ErrorAction SilentlyContinue) { $de = "MATE" }
		}

		if (-not $de) {
			$procs = (& ps aux 2>$null)
			if ($procs | Select-String "plasmashell") { $de = "KDE" }
			elseif ($procs | Select-String "gnome-shell") { $de = "GNOME" }
			elseif ($procs | Select-String "xfce4-session") { $de = "XFCE" }
			elseif ($procs | Select-String "mate-session") { $de = "MATE" }
			elseif ($procs | Select-String "cinnamon") { $de = "Cinnamon" }
			elseif ($procs | Select-String "budgie-daemon") { $de = "Budgie" }
		}

		if (-not $de) {
			$session2 = (& loginctl list-sessions --no-legend 2>$null) | Where-Object { $_ -match (& whoami) } | Select-Object -First 1 | ForEach-Object { ($_ -split "\s+")[0] }
			if ($session2) {
				$xdg = (& loginctl show-session $session2 -p Desktop --value 2>$null).Trim()
				if ($xdg) { $de = $xdg }
			}
		}

		if ($env:HYPRLAND_INSTANCE_SIGNATURE) {
			$wm = "Hyprland"
		} elseif ($env:SWAYSOCK) {
			$wm = "Sway"
		} elseif ($de) {
			$wm = switch ($de) {
				"KDE"        { "KWin" }
				"GNOME"      { "Mutter" }
				"XFCE"       { "Xfwm4" }
				"MATE"       { "Marco" }
				"Cinnamon"   { "Muffin" }
				"Budgie"     { "Budgie WM" }
				"LXQt"       { "Openbox" }
				"LXDE"       { "Openbox" }
				default      { "" }
			}
		}

		# session type
		$uid = (& id -u 2>$null)
		$userRun = "/run/user/$uid"
		$session_type = if ($env:WAYLAND_DISPLAY) { "Wayland" }
			elseif (Test-Path "$userRun/wayland-0") { "Wayland" }
			elseif ($env:DISPLAY) { "X11" }
			else { "" }
		$wm_theme = if ($session_type) { "$wm ($session_type)" } else { "" }

		# DE version
		if ($de) {
			$de_version = switch ($de) {
				"KDE"      { (& plasmashell --version 2>$null) -replace "plasmashell ", "" }
				"GNOME"    { (& gnome-shell --version 2>$null) -replace "GNOME Shell ", "" }
				"XFCE"     { (& xfce4-session --version 2>$null | Select-Object -First 1) -replace "xfce4-session ", "" }
				"Cinnamon" { (& cinnamon --version 2>$null) -replace "Cinnamon ", "" }
				"MATE"     { (& mate-session --version 2>$null | Select-Object -First 1) -replace "mate-session ", "" }
				default    { "" }
			}
		}

		# theme
		if ($env:GTK_THEME) {
			$theme = $env:GTK_THEME
		} elseif ($de -eq "KDE") {
			$theme = (& kreadconfig5 --group "General" --key "Name" --file kdeglobals 2>$null)
			if (-not $theme) { $theme = (& kreadconfig6 --group "General" --key "Name" --file kdeglobals 2>$null) }
		} elseif ($de -eq "GNOME" -or $de -eq "Cinnamon" -or $de -eq "MATE") {
			$theme = (& gsettings get org.gnome.desktop.interface gtk-theme 2>$null) -replace "'", ""
		}
	}
	if ($host.Name -eq "Windows PowerShell ISE Host" -or $psise) {
		if ([Environment]::Is64BitProcess) {
			$term = "Windows PowerShell ISE"
		} else {
			$term = "Windows PowerShell ISE(x86)"
		}
		$term_version = ""
	} elseif ($env:WT_SESSION) {
		$term = "Windows Terminal"
		$term_version = (Get-AppxPackage -Name Microsoft.WindowsTerminal -ErrorAction SilentlyContinue).Version
		if (-not $term_version) { $term_version = "" }
	} elseif ($env:TERM_PROGRAM) {
		switch ($env:TERM_PROGRAM) {
			"mintty"     { $term = "MinTTY" }
			"iTerm.app"  { $term = "iTerm2" }
			"WezTerm"    { $term = "WezTerm" }
			"vscode"     { $term = "VS Code" }
			"Hyper"      { $term = "Hyper" }
			"tabby"      { $term = "Tabby" }
			"linux"      { $term = "Linux TTY"}
			default      { $term = $env:TERM_PROGRAM }
		}
		$term_version = $env:TERM_PROGRAM_VERSION
		if (-not $term_version) { $term_version = "" }
	} elseif ($env:KITTY_WINDOW_ID) {
		$term = "Kitty"
		$term_version = ""
	} elseif ($env:KONSOLE_VERSION) {
		$term = "Konsole"
		$term_version = $env:KONSOLE_VERSION
	} elseif ($env:ALACRITTY_SOCKET -or $env:ALACRITTY_LOG) {
		$term = "Alacritty"
		$term_version = ""
	} elseif ($env:GNOME_TERMINAL_SERVICE) {
		$term = "GNOME Terminal"
		$term_version = ""
	} elseif ($env:TERM) {
		switch ($env:TERM) {
			"alacritty"      { $term = "Alacritty" }
			"kitty"          { $term = "Kitty" }
			"xterm-kitty"    { $term = "Kitty" }
			"rxvt-unicode"   { $term = "URxvt" }
			"linux"          { $term = "Linux TTY"}
			default          { $term = $env:TERM }
		}
		$term_version = ""
	} elseif ($IsWindows -or $PSVersionTable.PSEdition -eq 'Desktop' -or (!($IsLinux) -and !($IsMacOS))) {
		$term = "conhost"
		$term_version = ""
	} else {
		$term = "Unknown"
		$term_version = ""
	}
	$cursor = $null
	if ($IsWindows -or $PSVersionTable.PSEdition -eq 'Desktop' -or (!($IsLinux) -and !($IsMacOS))) {
		$cursor = (Get-Item "HKCU:\Control Panel\Cursors" -ErrorAction SilentlyContinue).GetValue("")
		if (-not $cursor) {
			$path = Get-ItemPropertyValue "HKCU:\Control Panel\Cursors" -Name "Arrow" -ErrorAction SilentlyContinue
			if ($path) { $cursor = [System.IO.Path]::GetFileNameWithoutExtension($path) }
		}
	}else {
		if ($env:XCURSOR_THEME) {
			$cursor = $env:XCURSOR_THEME
		} elseif ($de -eq "KDE") {
			$cursor = (& kreadconfig5 --group "Icons" --key "Cursor" --file kdeglobals 2>$null)
			if (-not $cursor) { $cursor = (& kreadconfig6 --group "Icons" --key "Cursor" --file kdeglobals 2>$null) }
		} elseif ($de -eq "GNOME" -or $de -eq "Cinnamon" -or $de -eq "MATE") {
			$cursor = (& gsettings get org.gnome.desktop.interface cursor-theme 2>$null) -replace "'", ""
		}
		if (-not $cursor) {
			if (Test-Path "$HOME/.config/gtk-3.0/settings.ini") {
				$cursor = (Get-Content "$HOME/.config/gtk-3.0/settings.ini" | Select-String "gtk-cursor-theme-name") -replace "gtk-cursor-theme-name\s*=\s*", ""
			}
		}
	}

	$sys_font = $null
if ($IsWindows -or $PSVersionTable.PSEdition -eq 'Desktop' -or (!($IsLinux) -and !($IsMacOS))) {
	$wh_font_active = Get-ChildItem "C:\ProgramData\Windhawk\Engine\ModsWritable\mod-status" -Filter "*_explorer-font-changer" -ErrorAction SilentlyContinue
	$wh_font = if ($wh_font_active) {
    Get-ItemPropertyValue "HKLM:\Software\Windhawk\Engine\Mods\explorer-font-changer\Settings" -Name "font.name" -ErrorAction SilentlyContinue
	}
	if ($wh_font) {
		$sys_font = $wh_font
	} else {
		$raw = (Get-ItemPropertyValue -Path "HKCU:\Control Panel\Desktop\WindowMetrics" -Name "IconFont" -ErrorAction SilentlyContinue)
		if ($raw) {
			$sys_font = ($raw[20..60] | ForEach-Object { [char]$_ } | Where-Object { $_ -ne [char]0 }) -join ""
		}
		if (-not $sys_font) {
			$sys_font = if (([System.Environment]::OSVersion.Version).Major -ge 10) { "Segoe UI" } else { "Tahoma" }
		}
	}
} else {
    if ($de -eq "GNOME" -or $de -eq "Cinnamon" -or $de -eq "MATE") {
        $sys_font = (& gsettings get org.gnome.desktop.interface font-name 2>$null) -replace "'", ""
    } elseif ($de -eq "KDE") {
        $sys_font = (& kreadconfig5 --group "General" --key "font" --file kdeglobals 2>$null)
        if (-not $sys_font) { $sys_font = (& kreadconfig6 --group "General" --key "font" --file kdeglobals 2>$null) }
    }
    if (-not $sys_font) {
        if (Test-Path "$HOME/.config/gtk-3.0/settings.ini") {
            $sys_font = (Get-Content "$HOME/.config/gtk-3.0/settings.ini" | Select-String "gtk-font-name") -replace "gtk-font-name\s*=\s*", ""
        }
    }
}
	$term_font = $null
	if ($term -eq "Windows Terminal") {
		$wtSettingsPath = $env:WT_SETTINGS_PATH
		if (-not $wtSettingsPath) {
			$wtSettingsPath = (Get-Item "$env:LOCALAPPDATA\Packages\Microsoft.WindowsTerminal_*\LocalState\settings.json" -ErrorAction SilentlyContinue).FullName
		}
		if ($wtSettingsPath -and (Test-Path $wtSettingsPath)) {
			try {
				$wtSettings = Get-Content $wtSettingsPath -Raw | ConvertFrom-Json
				$profile = $wtSettings.profiles.list | Where-Object { $_.guid -eq $env:WT_PROFILE_ID } | Select-Object -First 1
				if (-not $profile) { $profile = $wtSettings.profiles.defaults }
				$term_font = $profile.font.face
			} catch { $term_font = $null }
		}
		if (-not $term_font) { $term_font = "Cascadia Mono" }
	} elseif ($term -eq "Kitty" -and (Test-Path "$HOME/.config/kitty/kitty.conf")) {
		$term_font = (Get-Content "$HOME/.config/kitty/kitty.conf" | Select-String "^font_family") -replace "font_family\s+", ""
	} elseif ($term -eq "Alacritty") {
		if (test-path "$HOME/.config/alacritty") {
			$alacrittyToml = "$HOME/.config/alacritty/alacritty.toml"
			$alacrittyYml  = "$HOME/.config/alacritty/alacritty.yml"
			$alacrittyConfig = 1
		} else {
			$alacrittyToml = "~/AppData/Roaming/alacritty/alacritty.toml"
			$alacrittyYml = "~/AppData/Roaming/alacritty/alacritty.yml"
			$alacrittyConfig = 1
		}
		if ($alacrittyConfig) {
			if (Test-Path $alacrittyToml) {
				$term_font = (Get-Content $alacrittyToml | Select-String "^\s*family\s*=") -replace '.*=\s*"?([^"]+)"?.*', '$1'
			} elseif (Test-Path $alacrittyYml) {
				$term_font = (Get-Content $alacrittyYml | Select-String "^\s*family:") -replace '.*family:\s*', ''
			}
		}
	} elseif ($term -eq "Konsole") {
		$konsoleProfile = Get-ChildItem "$HOME/.local/share/konsole/*.profile" -ErrorAction SilentlyContinue | Select-Object -First 1
		if ($konsoleProfile) {
			$term_font = (Get-Content $konsoleProfile | Select-String "^Font=") -replace "Font=", "" -replace ",.*", ""
		}
	} elseif ($term -eq "conhost") {
		$kern = [System.Environment]::OSVersion.Version
		$term_font = if ($kern.Major -ge 10) { "Consolas" } else { "Lucida Console" }
	} elseif ($term -eq "Windows PowerShell ISE" -or $term -eq "Windows PowerShell ISE(x86)") {
		$term_font = $psise.options.fontname
	} elseif ($term -eq "Tabby") {
    $tabbyConfig = if ($IsWindows -or $PSVersionTable.PSEdition -eq "Desktop" -or (!($IsLinux) -and !($IsMacOS))) {
        "$env:APPDATA\tabby\config.yaml"
    } else {
        "$HOME/.config/tabby/config.yaml"
    }
    if (Test-Path $tabbyConfig) {
        try {
            $term_font = (Get-Content $tabbyConfig | Select-String "^\s*font:") -replace '.*font:\s*', ''
        } catch { $term_font = $null }
    }
} elseif ($term -eq "MinTTY") {
	if (test-path C:/msys64/home/cereal/.minttyrc) {
		$term_font = (Select-String -Path "C:\msys64\home\cereal\.minttyrc" -Pattern '^Font=').Line -replace '^Font=', ''
	}
}
	if (-not $term_font -and $term -eq "Windows Terminal") {
		$term_font = "Cascadia Mono"
	}
	<#if ($bloat) {
		if ($term -eq "Windows Terminal") {
			$wtSettingsPath = $env:WT_SETTINGS_PATH
			if (-not $wtSettingsPath) {
				$wtSettingsPath = (Get-Item "$env:LOCALAPPDATA\Packages\Microsoft.WindowsTerminal_*\LocalState\settings.json" -ErrorAction SilentlyContinue).FullName
			}
			if ($wtSettingsPath -and (Test-Path $wtSettingsPath)) {
				try {
					$wtSettings = Get-Content $wtSettingsPath -Raw | ConvertFrom-Json
					$profile = $wtSettings.profiles.list | Where-Object { $_.guid -eq $env:WT_PROFILE_ID } | Select-Object -First 1
					if (-not $profile) { $profile = $wtSettings.profiles.defaults }
					$bloat_wtpname = $profile.name
					$bloat_wtpscheme = $profile.colorScheme
					$shaderPath   = $profile.psobject.Properties["experimental.pixelShaderPath"]?.Value
					$retroEffect  = $profile.psobject.Properties["experimental.retroTerminalEffect"]?.Value

					if ($shaderPath) {
						$bloat_shader = ([System.IO.Path]::GetFileNameWithoutExtension($shaderPath)).Replace('_', ' ')
					} elseif ($retroEffect) {
						$bloat_shader = "Retro Terminal"
					}
					if ($null -ne $profile.opacity) {
						$bloat_opacity = $profile.opacity
					}
				} catch {
					$idk = "what am i even doing"
				}
			} 
		}
	}#> # why did i make this?
		# preserved for the forks to use ig
	if ($larp) {
		$resolvedosc = resolveOSC($larp)
		if (-not $backend) {
			if ($larp -notin $validOSes) {
				render "fetch_unknown_os"
			} else {
				render $larp
			}
		} else {
			write-output "OSKey:         $larp"
		}
		if ($larp -eq "win_fetch" -or $larp -eq "windows") {
			write-output "$($resolvedosc)OS:            Windows"
		} elseif ($larp -eq "win10_fetch" -or $larp -eq "windows_10") {
			write-output "$($resolvedosc)OS:            Windows 10"
		} elseif ($larp -eq "win11_fetch" -or $larp -eq "windows_11") {
			write-output "$($resolvedosc)OS:            Windows 11"
		} elseif ($larp -eq "arch") {
			write-output "$($resolvedosc)OS:            Arch" # btw
		} elseif ($larp -eq "mint" -or $larp -eq "linux_mint") {
			write-output "$($resolvedosc)OS:            Linux Mint"
		} elseif ($larp -eq "debian") {
			write-output "$($resolvedosc)OS:            Debian"
		} elseif ($larp -eq "pop") {
			write-output "$($resolvedosc)OS:            Pop!_OS"
		} elseif ($larp -eq "tux" -or $larp -eq "linux") {
			write-output "$($resolvedosc)OS:            Linux"
		} elseif ($larp -eq "ubuntu") {
			write-output "$($resolvedosc)OS:            Ubuntu"
		} elseif ($larp -eq "mac") {
			write-output "$($resolvedosc)OS:            MacOS"
		} elseif ($larp -eq "cerealos") {
			write-output "$($resolvedosc)OS:            CerealOS"
		} elseif ($larp -eq "artix") {
			write-output "$($resolvedosc)OS:            Artix"
		} elseif ($larp -eq "fedora") {
			write-output "$($resolvedosc)OS:            Fedora"
		} elseif ($larp -eq "android") {
			write-output "$($resolvedosc)OS:            Android"
		} elseif ($larp -eq "amogos") {
			write-output "$($resolvedosc)OS:            AmogOS"
		} elseif ($larp -eq "alpine") {
			write-output "$($resolvedosc)OS:            Alpine"
		} elseif ($larp -eq "nyarch") {
			write-output "$($resolvedosc)OS:            Nyarch"
		} elseif ($larp -eq "gentoo") {
			write-output "$($resolvedosc)OS:            Gentoo"
		} elseif ($larp -eq "opensuse" -or $larp -eq "opensuse_leap") {
			write-output "$($resolvedosc)OS:            openSUSE"
		} elseif ($larp -eq "opensuse_butter" -or $larp -eq "opensuse_tumbleweed") {
			write-output "$($resolvedosc)OS:            openSUSE"
		} elseif ($larp -eq "lesbian") {
			write-output "$($resolvedosc)OS:            Lesbian"
		} elseif ($larp -eq "kde_neon" -or $larp -eq "neon") {
			write-output "$($resolvedosc)OS:            KDE Neon"
		} elseif ($larp -eq "elementary") {
			write-output "$($resolvedosc)OS:            ElementaryOS"
		} elseif ($larp -eq "zorin") {
			write-output "$($resolvedosc)OS:            Zorin OS"
		} elseif ($larp -eq "uwuntu") {
			write-output "$($resolvedosc)OS:            UwUntu"
		} elseif ($larp -eq "manjaro") {
			write-output "$($resolvedosc)OS:            Manjaro"
		} elseif ($larp -eq "kali") {
			write-output "$($resolvedosc)OS:            Kali"
		} elseif ($larp -eq "raspbian") {
			write-output "$($resolvedosc)OS:            Raspbian"
		} elseif ($larp -eq "raspberry" -or $larp -eq "pi") {
			write-output "$($resolvedosc)OS:            Raspberry Pi OS"
		} elseif ($larp -eq "discord") {
			write-output "$($resolvedosc)OS:            Discord"
		} elseif ($larp -eq "winmeows") {
			write-output "$($resolvedosc)OS:            Winmeows"
		} elseif ($larp -eq "cachy") {
			write-output "$($resolvedosc)OS:            CachyOS"
		} else { 
			write-output "$($resolvedosc)OS:            $larp"
		}
	} else {
		$logo = Get-OSKey
		if ($logo -eq "win11_fetch" -and (test-osrelease)) {
			$logo = Get-OSKey -skipOSR
		}
		if($logo -eq "debian") {
			$logo = lesbian
		}
		$resolvedosc = resolveOSC($logo)
		if (-not $backend) {
			if ($logo -notin $validOSes) {
				render "fetch_unknown_os"
			} else {
				render $logo
			}
			} else {
				write-output "OSKey:         $logo"
		}
		$winedition = $script:osInfo.Caption -replace "Microsoft Windows \d+ ", ""
		$winversion = $script:osInfo.Caption -replace "Microsoft Windows ", ""
		if ($logo -eq "win_fetch") {
			write-output "$($resolvedosc)OS:            Windows $winversion"
		} elseif ($logo -eq "win10_fetch") {
			write-output "$($resolvedosc)OS:            Windows 10 $winedition"
		} elseif ($logo -eq "win11_fetch") {
			write-output "$($resolvedosc)OS:            Windows 11 $winedition"
		} elseif ($logo -eq "arch") {
			write-output "$($resolvedosc)OS:            Arch" # btw
		} elseif ($logo -eq "mint") {
			write-output "$($resolvedosc)OS:            Linux Mint"
		} elseif ($logo -eq "debian") {
			write-output "$($resolvedosc)OS:            Debian"
		} elseif ($logo -eq "pop") {
			write-output "$($resolvedosc)OS:            Pop!_OS"
		} elseif ($logo -eq "tux") {
			write-output "$($resolvedosc)OS:            Linux"
		} elseif ($logo -eq "ubuntu") {
			write-output "$($resolvedosc)OS:            Ubuntu"
		} elseif ($logo -eq "mac") {
			write-output "$($resolvedosc)OS:            MacOS"
		} elseif ($logo -eq "artix") {
			write-output "$($resolvedosc)OS:            Artix"
		} elseif ($logo -eq "fedora") {
			write-output "$($resolvedosc)OS:            Fedora"
		} elseif ($logo -eq "android") {
			write-output "$($resolvedosc)OS:            Android"
		} elseif ($logo -eq "amogos") {
			write-output "$($resolvedosc)OS:            AmogOS"
		} elseif ($logo -eq "alpine") {
			write-output "$($resolvedosc)OS:            Alpine"
		} elseif ($logo -eq "nyarch") {
			write-output "$($resolvedosc)OS:            Nyarch"
		} elseif ($logo -eq "gentoo") {
			write-output "$($resolvedosc)OS:            Gentoo"
		} elseif ($logo -eq "opensuse") {
			write-output "$($resolvedosc)OS:            openSUSE"
		} elseif ($logo -eq "opensuse_butter") {
			write-output "$($resolvedosc)OS:            openSUSE"
		} elseif ($logo -eq "lesbian") {
			write-output "$($resolvedosc)OS:            Lesbian"
		} elseif ($logo -eq "cerealos") {
			write-output "$($resolvedosc)OS:            CerealOS"
		} elseif ($logo -eq "kde_neon" -or $logo -eq "neon") {
			write-output "$($resolvedosc)OS:            KDE Neon"
		} elseif ($logo -eq "elementary") {
			write-output "$($resolvedosc)OS:            ElementaryOS"
		} elseif ($logo -eq "zorin") {
			write-output "$($resolvedosc)OS:            Zorin OS"
		} elseif ($logo -eq "uwuntu") {
			write-output "$($resolvedosc)OS:            UwUntu"
		} elseif ($logo -eq "discord") {
			write-output "$($resolvedosc)OS:            Discord"
		} elseif ($logo -eq "manjaro") {
			write-output "$($resolvedosc)OS:            Manjaro"
		} elseif ($logo -eq "kali") {
			write-output "$($resolvedosc)OS:            Kali"
		} elseif ($logo -eq "raspbian") {
			write-output "$($resolvedosc)OS:            Raspbian"
		} elseif ($logo -eq "raspberry" -or $logo -eq "pi") {
			write-output "$($resolvedosc)OS:            Raspberry Pi OS"
		} elseif ($logo -eq "discord") {
			write-output "$($resolvedosc)OS:            Discord"
		} elseif ($logo -eq "winmeows") {
			write-output "$($resolvedosc)OS:            Winmeows $winversion"
		} elseif ($logo -eq "cachy") {
			write-output "$($resolvedosc)OS:            CachyOS"
		} else {
			if ($IsWindows -or ($PSVersionTable.PSEdition -eq "Desktop") -or (!($IsLinux) -and !($IsMacOS))) {
				if (!$backend) {
					render win_fetch
				}
				$winfallback = $script:osInfo.Caption -replace "Microsoft ", ""
				write-host "$($resolvedosc)OS:            $winfallback"
			} elseif ($IsMac) {
				if (!$backend) {
					render mac
				}
				resolveOSC("mac")
				write-output "$($resolvedosc)OS:            MacOS"
			} elseif ($IsLinux) {
				if (!$backend) {
					render tux
				}
				resolveOSC("tux")
				write-output "$($resolvedosc)OS:            Linux"
			} else {
				write-output "$($resolvedosc)OS:            Unknown" # ...? TempleOS is that you??
			}
		}
	}
	if ($IsWindows -or ($PSVersionTable.PSEdition -eq "Desktop") -or (!($IsLinux) -and !($IsMacOS))) {
		if ($bloat) {
			Write-output "$($resolvedosc)OS Class:      NT" # ... it says this in the kernel name ... why do you need to know?
		}
		$kern = [System.Environment]::OSVersion.Version
		if ($precise) {
			if ($PSVersionTable.Platform) {
				$kerntype = $($PSVersionTable.Platform)
			} else {
				$kerntype = "Win32NT"
			}
		} else {
			if ($($PSVersionTable.Platform) -eq "Win32NT") {
				$kerntype = "Windows NT"
			} else {
				if ($PSVersionTable.Platform) {
					$kerntype = $($PSVersionTable.Platform)
				} else {
					$kerntype = "Windows NT"
				}
			}
		}
		if (-not ($kern.Revision -ge 1)) {
			Write-output "$($resolvedosc)Kernel:        $kerntype $($kern.Major).$($kern.Minor).$($kern.Build)"
		} else {
			write-output "$($resolvedosc)Kernel:        $kerntype $($kern.Major).$($kern.Minor).$($kern.Build).$($kern.Revision)"
		}
		if($extra) {
			if (get-command hostname -erroraction silentlycontinue) {
				$hostid = hostname
			} elseif ($env:USERDOMAIN) {
				$hostid = $env:USERDOMAIN
			} elseif ($script:osInfo) {
				$hostid = $script:osInfo.CSName # we already have this cached from win 11 caption
			} elseif (whoami --erroraction silentlycontinue) {
				$hostid = $((whoami).Split('\')[0]) # boring whoami fallback, slowest option
			} else {
				if ($script:csystem) {
					$hostid = $script:csystem.Name
				}
			}
			if ($env:USERNAME) {
				$user = $env:USERNAME
			} else {
				$user = $((whoami).Split('\')[1]) # no huge fallback path.. strange..
			}
			write-output "$($resolvedosc)User:          $user@$hostid"
		}
		if ($ESVersionTable -and $Precise) {
			if ($script:sh -eq "nu.exe") {
				write-output "$($resolvedosc)Shell:         emberShell $($ESVersionTable.ESEdition) $($ESVersionTable.ESVersion) `(NuShell $(nu -c '(version).version'))"
			} elseif ($script:sh -eq "bash.exe") {
				$bashver = bash -c 'echo "${BASH_VERSINFO[0]}.${BASH_VERSINFO[1]}.${BASH_VERSINFO[2]}"'
				write-output "$($resolvedosc)Shell:         emberShell $($ESVersionTable.ESEdition) $($ESVersionTable.ESVersion) `(bash $bashver)"
			} elseif ($script:sh -eq "fish.exe") {
				if (test-path C:\msys64\usr\bin\bash.exe) {
					$rawfish = C:\msys64\usr\bin\bash.exe --login -i -c "fish --version"
					$fishdat = $rawfish -replace '^fish, version\s+', ''
					$fishver = "fish $fishdat"
				} elseif (gcm fish) {
					$rawfish = fish --version
					$fishdat = $rawfish -replace '^fish, version\s+', ''
					$fishver = "fish $fishdat"
				} else {
					$fishver = "fish"
				}
				write-output "$($resolvedosc)Shell:         emberShell $($ESVersionTable.ESEdition) $($ESVersionTable.ESVersion) `($fishver)"
			} elseif ($script:sh -eq "zsh.exe") {
				if (test-path C:\msys64\usr\bin\bash.exe) {
					$zshraw = C:\msys64\usr\bin\bash.exe --login -i -c "zsh --version"
				} elseif (gcm zsh) {
					$zshraw = zsh --version
				} else {
					$zshraw = "zsh"
				}
				$zshver = $zshraw -replace '\s*\(.*\)$', ''
				write-output "$($resolvedosc)Shell:         emberShell $($ESVersionTable.ESEdition) $($ESVersionTable.ESVersion) `($zshver)"
			} elseif ($script:sh -eq "cmd.exe") {
				if ($script:ancestorProcess.Name -eq "lua.exe") {
					$parstring = (lua -v 2>&1) -replace '\s+Copyright.*', ''
					write-output "$($resolvedosc)Shell:         emberShell $($ESVersionTable.ESEdition) $($ESVersionTable.ESVersion) `($parstring)"
				} else {
					if ("$(& $script:shpath /? 2>$null)" -match "ReactOS") {
						write-output "$($resolvedosc)Shell:         emberShell $($ESVersionTable.ESEdition) $($ESVersionTable.ESVersion) `(ReactOS CMD $script:cmdver)"
					} else {
						write-output "$($resolvedosc)Shell:         emberShell $($ESVersionTable.ESEdition) $($ESVersionTable.ESVersion) `(CMD $script:cmdver)"
					}
				}
			} elseif ($script:sh -eq "node.exe") {
				write-output "$($resolvedosc)Shell:         emberShell $($ESVersionTable.ESEdition) $($ESVersionTable.ESVersion) `(Node $((node --version) -replace '^v', ''))"
			} elseif ($script:sh -eq "python.exe") {
				write-output "$($resolvedosc)Shell:         emberShell $($ESVersionTable.ESEdition) $($ESVersionTable.ESVersion) `($(python --version))"
			} else {
				write-output "$($resolvedosc)Shell:         emberShell $($ESVersionTable.ESEdition) $($ESVersionTable.ESVersion) `($($PSVersionTable.PSEdition) $($PSVersionTable.PSVersion)`)"
			}
		} elseif ($ESVersionTable) { # hey cool! someone using clib the intended way
			write-output "$($resolvedosc)Shell:         emberShell $($ESVersionTable.ESEdition) $($ESVersionTable.ESVersion)"
		} elseif ($Precise) {
			if ($script:sh -eq "nu.exe") {
				write-output "$($resolvedosc)Shell:         NuShell $(nu -c '(version).version') `($($PSVersionTable.PSEdition) $($PSVersionTable.PSVersion))"
			} elseif ($script:sh -eq "bash.exe") {
				$bashver = bash -c 'echo "${BASH_VERSINFO[0]}.${BASH_VERSINFO[1]}.${BASH_VERSINFO[2]}"'
				write-output "$($resolvedosc)Shell:         bash $bashver `($($PSVersionTable.PSEdition) $($PSVersionTable.PSVersion))"
			} elseif ($script:sh -eq "fish.exe") {
				if (test-path C:\msys64\usr\bin\bash.exe) {
					$rawfish = C:\msys64\usr\bin\bash.exe --login -i -c "fish --version"
					$fishdat = $rawfish -replace '^fish, version\s+', ''
					$fishver = "fish $fishdat"
				} elseif (gcm fish) {
					$rawfish = fish --version
					$fishdat = $rawfish -replace '^fish, version\s+', ''
					$fishver = "fish $fishdat"
				} else {
					$fishver = "fish `($($PSVersionTable.PSEdition) $($PSVersionTable.PSVersion))"
				}
				write-output "$($resolvedosc)Shell:         $fishver"
			} elseif ($script:sh -eq "zsh.exe") {
				if (test-path C:\msys64\usr\bin\bash.exe) {
					$zshraw = C:\msys64\usr\bin\bash.exe --login -i -c "zsh --version"
				} elseif (gcm zsh) {
					$zshraw = zsh --version
				} else {
					$zshraw = "zsh"
				}
				$zshver = $zshraw -replace '\s*\(.*\)$', ''
				write-output "$($resolvedosc)Shell:         $zshver `($($PSVersionTable.PSEdition) $($PSVersionTable.PSVersion))"
			} elseif ($script:sh -eq "node.exe") {
				write-output "$($resolvedosc)Shell:         Node $((node --version) -replace '^v', '') `($($PSVersionTable.PSEdition) $($PSVersionTable.PSVersion))"
			} elseif ($script:sh -eq "python.exe") {
				write-output "$($resolvedosc)Shell:         $(python --version) `($($PSVersionTable.PSEdition) $($PSVersionTable.PSVersion))"
			} elseif ($script:sh -eq "cmd.exe") {
				if ($script:ancestorProcess.Name -eq "lua.exe") {
					$parstring = (lua -v 2>&1) -replace '\s+Copyright.*', ''
					write-output "$($resolvedosc)Shell:         $parstring `($($PSVersionTable.PSEdition) $($PSVersionTable.PSVersion))"
				} else {
					if ("$(& $script:shpath /? 2>$null)" -match "ReactOS") {
						write-output "$($resolvedosc)Shell:         ReactOS CMD $script:cmdver `($($PSVersionTable.PSEdition) $($PSVersionTable.PSVersion))"
					} else {
						write-output "$($resolvedosc)Shell:         CMD $script:cmdver `($($PSVersionTable.PSEdition) $($PSVersionTable.PSVersion))"
					}
				}
			} else {
				write-output "$($resolvedosc)Shell:         PowerShell $($PSVersionTable.PSEdition) $($PSVersionTable.PSVersion)"
			}
		} else {
			if ($script:sh -eq "nu.exe") {
				write-output "$($resolvedosc)Shell:         NuShell $(nu -c '(version).version')"
			} elseif ($script:sh -eq "bash.exe") {
				$bashver = bash -c 'echo "${BASH_VERSINFO[0]}.${BASH_VERSINFO[1]}.${BASH_VERSINFO[2]}"'
				write-output "$($resolvedosc)Shell:         bash $bashver"
			} elseif ($script:sh -eq "fish.exe") {
				if (test-path C:\msys64\usr\bin\bash.exe) {
					$rawfish = C:\msys64\usr\bin\bash.exe --login -i -c "fish --version"
					$fishdat = $rawfish -replace '^fish, version\s+', ''
					$fishver = "fish $fishdat"
				} elseif (gcm fish) {
					$rawfish = fish --version
					$fishdat = $rawfish -replace '^fish, version\s+', ''
					$fishver = "fish $fishdat"
				} else {
					$fishver = "fish"
				}
				write-output "$($resolvedosc)Shell:         $fishver"
			} elseif ($script:sh -eq "zsh.exe") {
				if (test-path C:\msys64\usr\bin\bash.exe) {
					$zshraw = C:\msys64\usr\bin\bash.exe --login -i -c "zsh --version"
				} elseif (gcm zsh) {
					$zshraw = zsh --version
				} else {
					$zshraw = "zsh"
				}
				$zshver = $zshraw -replace '\s*\(.*\)$', ''
				write-output "$($resolvedosc)Shell:         $zshver"
			} elseif ($script:sh -eq "cmd.exe") {
				if ($script:ancestorProcess.Name -eq "lua.exe") {
					$parstring = (lua -v 2>&1) -replace '\s+Copyright.*', ''
					write-output "$($resolvedosc)Shell:         $parstring"
				} else {
					if ("$(& $script:shpath /? 2>$null)" -match "ReactOS") {
						write-output "$($resolvedosc)Shell:         ReactOS CMD $script:cmdver"
					} else {
						write-output "$($resolvedosc)Shell:         CMD $script:cmdver"
					}
				}
			} elseif ($script:sh -eq "node.exe") {
				write-output "$($resolvedosc)Shell:         Node $((node --version) -replace '^v', '')"
			} elseif ($script:sh -eq "python.exe") {
				write-output "$($resolvedosc)Shell:         $(python --version)"
			} else {
				write-output "$($resolvedosc)Shell:         PowerShell $($PSVersionTable.PSEdition) $("$($PSVersionTable.PSVersion)".Substring(0,5))"
			}
		}
		if ($pkgs) {
			$pkglines = @()
			if ($script:wget_count)    { $pkglines += "winget   - $script:wget_count" }
			if ($script:scoop_count)   { $pkglines += "scoop    - $script:scoop_count" }
			if ($script:choco_count)   { $pkglines += "choco    - $script:choco_count" }
			if ($script:cpkg_count)    { $pkglines += "cpkg     - $script:cpkg_count" }
			if ($script:pacman_count)  { $pkglines += "pacman   - $script:pacman_count" }
			if ($langpkgs) {
			if ($script:npm_count)     { $pkglines += "npm      - $script:npm_count" }
			if ($script:pip_count)     { $pkglines += "pip      - $script:pip_count" }
			if ($script:cargo_count)   { $pkglines += "cargo    - $script:cargo_count" }
			if ($script:gem_count)     { $pkglines += "gem      - $script:gem_count" }
			if ($script:luarocks_count){ $pkglines += "luarocks - $script:luarocks_count" }
			if ($script:psget_count)   { $pkglines += "psget    - $script:PSGet_count" }
			}
			if ($pkglines.Count -gt 0) {
				$label = "Packages:"
				foreach ($line in $pkglines) {
					write-output "$($resolvedosc)$($label.PadRight(15))$line"
					$label = ""  # blank after first line so label only prints once
				}
			}
		}
		if ($precise) {
			write-output "$($resolvedosc)Terminal:      $term $term_version"
		} else {
			write-output "$($resolvedosc)Terminal:      $term"
		}
		if ($term_font) {
			write-output "$($resolvedosc)Terminal Font: $term_font"
		}
		<#if ($bloat) {
			if ($bloat_wtpname) {
				write-output "$($resolvedosc)Profile:       $bloat_wtpname"
			}
			if ($bloat_wtpscheme) {
				write-output "$($resolvedosc)Color Scheme:  $bloat_wtpscheme"
			}
			if ($bloat_shader) {
				write-output "$($resolvedosc)Shader:        $bloat_shader"
			}
			if ($bloat_opacity) {
				write-output "$($resolvedosc)Opacity:       $bloat_opacity"
			}
		} #>
		if ($precise) {
			Write-Output "$($resolvedosc)WM:            $wm $wm_version"
		} else {
			Write-Output "$($resolvedosc)WM:            $wm"
		}
		Write-Output "$($resolvedosc)WM Theme:      $wm_theme"
		Write-Output "$($resolvedosc)Accent Color:  $(htaToolPure $accent_color)$accent_color$($color.reset)"
		Write-Output "$($resolvedosc)System Font:   $sys_font"
		if($cursor) {
			Write-Output "$($resolvedosc)Cursor:        $cursor"
		}
		Write-Output "$($resolvedosc)CPU:           $($script:cpu.Name)"
		Write-Output "$($resolvedosc)CPU Base:      $($script:cpu.MaxClockSpeed)MHz"
		Write-Output "$($resolvedosc)CPU Boost:     $($script:cpu.BoostClockSpeed)MHz"
		Write-Output "$($resolvedosc)CPU Cores:     $($script:cpu.NumberOfCores)"
		Write-Output "$($resolvedosc)CPU Threads:   $($script:cpu.NumberOfLogicalProcessors)"
		if ($bloat) {
			$architecture = $env:PROCESSOR_ARCHITECTURE
			$bits = switch ($architecture) {
				"x86"    { "32-bit" }
				"ARM"    { "32-bit" }
				"armv7l" { "32-bit" }
				"i386"   { "32-bit" }
				"i486"   { "32-bit" }
				"i586"   { "32-bit" }
				"i686"   { "32-bit" }
				default  { "64-bit" }
			}
			Write-Output "$($resolvedosc)Architecture:  $architecture ($bits)"
		}
		$total = ($script:ram | Measure-Object -Property Capacity -Sum).Sum / 1GB
		if($script:gpu.AdapterDACType -eq "Internal") {
			if ($precise) {
				$usable = $script:osInfo.TotalVisibleMemorySize / 1MB
				$reserved = [math]::Round(($total - $usable) * 1024, 0)
				if ($reserved -gt 1024) {
					$reservedgb = [math]::Round($reserved / 1024, 0)
					$usageigpu = "($reservedgb`GB)"
				} else {
					$usageigpu = "($reserved`MB)"
				}
			} else {$usageigpu = ""}
			$type = "[Integrated] $usageigpu"
		} else {
			$type = ""
		}
		Write-Output "$($resolvedosc)GPU:           $($script:gpu.Name) $type"
		$speed = $script:ram[0].Speed
		$gen = switch ($script:ram[0].SMBIOSMemoryType) {
			18 { "DDR" }
			19 { "DDR2" }
			20 { "DDR2 FB-DIMM" }
			24 { "DDR3" }
			25 { "FBD2" }
			26 { "DDR4" }
			27 { "LPDDR" }
			28 { "LPDDR2" }
			29 { "LPDDR3" }
			30 { "LPDDR4" }
			31 { "LPDDR4X" }
			32 { "DDR5" }
			33 { "LPDDR5" }
			34 { "DDR5" }
			35 { "LPDDR5X" }
			default { "DDR?" }
		}
		if ($gen -eq "DDR?") {
			$gen = switch ($script:ram[0].MemoryType) {
				2 {"DRAM"}
				3 {"Synchronous DRAM"}
				4 {"Cache DRAM"}
				5 {"EDO"}
				6 {"EDRAM"}
				7 {"VRAM"}
				8 {"SRAM"}
				9 {"RAM"}
				10 {"ROM"}
				11 {"Flash"}
				12 {"EEPROM"}
				13 {"FEPROM"}
				14 {"EPROM"}
				15 {"CDRAM"}
				16 {"3DRAM"}
				17 {"SDRAM"}
				18 {"SGRAM"}
				19 {"RDRAM"}
				20 {"DDR"}
				21 {"DDR2"}
				22 {"DDR2 FB-DIMM"}
				23 {"FB-DIMM"}
				24 {"DDR3"}
				25 {"FBD2"}
				26 {"DDR4"}
				default {"RAM"} # how the HELL..? failing when even VRAM as system ram is detected..???
			}
		}
		$soldered = @(27,28,29,30,31,33,35) # guys can we stop doing this stuff.. please..
		if ($script:ram[0].SMBIOSMemoryType -in $soldered) {
			$ff = "Soldered"
		} else {
			$ff = switch($script:ram[0].FormFactor) {
				2 {"SIP"}
				3 {"DIP"}
				4 {"ZIP"}
				5 {"SOJ"}
				6 {"Proprietary Card"}
				7 {"SIMM"}
				8 {"DIMM"}
				9 {"TSOP"}
				10 {"PGA"}
				11 {"RIMM"}
				12 {"SO-DIMM"}
				13 {"SRIMM"}
				14 {"SMD"}
				15 {"SSMP"}
				16 {"QFP"}
				17 {"TQFP"}
				18 {"SOIC"}
				19 {"LCC"}
				20 {"PLCC"}
				21 {"BGA"}
				22 {"FBGA"}
				23 {"LGA"}
				24 {"FB-DIMM"} # this is likely to display weird, maybe change this? >> #1893
				25 {"Die"}
				26 {"CAMM"}
				default {$null}
			}
		}
		if (-not $ff) {
			$ffadd = ""
			if ($script:ram[0].Replaceable -eq $true -or $script:ram[0].Removable -eq $true) {
				$ffadd += "Replaceable "
			}
			if ($script:ram[0].HotSwappable) {
				$ffadd += "Hot Swappable " # wtf?
			}
			$ff = $ffadd.Trim()
		}
		if ($ff -eq "FB-DIMM" -and ($gen -eq "DDR2 FB-DIMM" -or $gen -eq "FB-DIMM")) {
			$ff = "" # fixed :3 >> #1876
		}
		$usedRam = [math]::Round(($script:osInfo.TotalVisibleMemorySize - $script:osInfo.FreePhysicalMemory) / 1MB, 1)
		$totalRam = [math]::Round($script:osInfo.TotalVisibleMemorySize / 1MB, 1)
		$rampercent = [math]::Round(($usedRam/$totalRam)*100, 0)
		if($rampercent -ge 75) {$col = $($color.red)} elseif ($rampercent -ge 50){$col = $($color.yellow)} else {$col = $($color.green)}
	    $MMF = $script:ram[0].Manufacturer
		if ($precise) {
			if ($bloat) {
				Write-Output "$($resolvedosc)RAM:           $($MMF) $($total)GB $($ff) $($gen) $($speed)MT/s"
			} else {
				Write-Output "$($resolvedosc)RAM:           $($total)GB $($ff) $($gen) $($speed)MT/s"
			}
		} elseif ($bloat) {
			Write-Output "$($resolvedosc)RAM:           $($MMF) $($total)GB $($gen) $($speed)MT/s"
		} else {
			Write-Output "$($resolvedosc)RAM:           $($total)GB $($gen) $($speed)MT/s"
		}
		write-output "$($resolvedosc)RAM Usage:     $usedram`GB/$totalram`GB ($col$rampercent`%$($resolvedosc))"
		$swapTotal = [math]::Round(($swap | Measure-Object -Property AllocatedBaseSize -Sum).Sum / 1024, 1)
		$swapUsed  = [math]::Round(($swap | Measure-Object -Property CurrentUsage -Sum).Sum / 1024, 1)
		$swapPercent = if ($swapTotal -gt 0) { [math]::Round(($swapUsed / $swapTotal) * 100) } else { 0 }
		if ($swapPercent -ge 75) { $swapCol = $($color.red) }
		elseif ($swapPercent -ge 50) { $swapCol = $($color.yellow) }
		else { $swapCol = $($color.green) }
		if ($swapTotal -gt 0) {
			Write-Output "$($resolvedosc)Swap:          ${swapUsed}GB/${swapTotal}GB ($swapCol${swapPercent}%$($resolvedosc))"
		}
		$disks = Get-PhysicalDisk | Sort-Object DeviceId
		$prefix = "$($resolvedosc)Storage:       "
		$indent = "$($resolvedosc)               "
		$first = $true
		foreach ($disk in $disks) {
			$size = $disk.Size
			$sizeStr = if ($size -ge 1000000000000) { "$([math]::Round($size / 1000000000000, 1))TB" }
				else { "$([math]::Round($size / 1000000000))GB" }
			$bus = $disk.BusType
			$type = $disk.MediaType
			$label = if ($bus -eq "NVMe") { "NVMe SSD" }
					 elseif ($bus -eq "USB") { "USB Drive" }
					 elseif ($type -eq "SSD") { "SATA SSD" }
					 elseif ($type -eq "HDD") { "HDD" }
					 elseif ($bus -eq "ATAPI") { "Disc Drive" }
					 else { "$bus $type".Trim() }
			if ($first) {
				Write-Output "$($resolvedosc)$prefix$sizeStr $label"
				$first = $false
			} else {
				Write-Output "$($resolvedosc)$indent$sizeStr $label"
			}
		}
		if ($DiskUsage) {
			$ldPrefix = "$($resolvedosc)Storage Usage: "
			$ldindent = "$($resolvedosc)               "
			$firstLd = $true
			foreach ($ld in $logicalDisks) {
				$letter = $ld.DeviceID
				$fs     = if ($ld.FileSystem) { $ld.FileSystem } else { "RAW" }
				$total  = $ld.Size
				$free   = $ld.FreeSpace
				$used   = $total - $free
				$usedStr  = if ($used  -ge 1000000000000) { "$([math]::Round($used  / 1000000000000, 1))TB" }
							else { "$([math]::Round($used  / 1000000000, 1))GB" }
				$totalStr = if ($total -ge 1000000000000) { "$([math]::Round($total / 1000000000000, 1))TB" }
							else { "$([math]::Round($total / 1000000000, 1))GB" }
				$diskpercent = if ($total -gt 0) { [math]::Round(($used / $total) * 100) } else { 0 }
				$pct = if ($total -gt 0) { "$diskpercent%" } else { "N/A" }
				$col = if ($diskpercent -ge 75) { $color.red } elseif ($diskpercent -ge 50) { $color.yellow } else { $color.green }
				$line = "$letter $usedStr/$totalStr ($($col)$diskpercent%$($resolvedosc)) $fs"
				if ($firstLd) {
					Write-Output "$($ldPrefix)$line"
					$firstLd = $false
				} else {
					Write-Output "$($ldIndent)$line"
				}
			}
		}
		if ($script:mobo.manufacturer -eq "N/A") {
			$modelKey = if ($script:csystem.Manufacturer) { $script:csystem.Manufacturer } else { $script:csysprod.Vendor }
			if ($annoyingOEM.ContainsKey($modelKey)) {
				$moboman = $annoyingOEM[$modelKey]
			}
			elseif ($script:bios.manufacturer) {
				$moboman = $script:bios.Manufacturer
			} else {
				$moboman = "Generic" # moboman(TM).. or something
			}
		} else {
			$moboman = $script:mobo.Manufacturer
		}
		if ($script:mobo.product -eq "N/A") {
			$moboprod = "Motherboard"
			$modelKey = if ($script:csystem.Model) { $script:csystem.Model } else { $script:csysprod.Model }
			if ($annoyingOEM.ContainsKey($modelKey)) {
				$moboprod = $annoyingOEM[$modelKey]
			}
		} else {
			$moboprod = $script:mobo.Product
		}
		Write-Output "$($resolvedosc)Motherboard:   $($moboman) $($moboprod)"
		if ($extra) {
			if ($script:csystem.Manufacturer) {
				$csysMan = $script:csystem.Manufacturer
			} else {
				if ($script:csysprod.Vendor) {
					$csysMan = $script:csysprod.Vendor
				}
			}
			if ($annoyingOEM.ContainsKey($csysMan)) {
				$csysMan = $annoyingOEM[$csysMan]
			}
			if ($script:csystem.Model) {
				$csysModel = $script:csystem.Model
			} else {
				if (-not $script:csysprod) {
				}
				if ($script:csysprod.Model) {
					$csysModel = $script:csysprod.Model
				}
			}
			if ($script:csystem.PCSystemType) {
				$modtype = switch($script:csystem.PCSystemType) {
					1 {"Desktop Model: "}
					2 {"Laptop Model:  "}
					3 {"Desktop Model: "}
					4 {"Server Model:  "}
					5 {"Server Model:  "}
					6 {"Desktop Model: "}
					7 {"Server Model:  "}
					8 {"Tablet Model:  "} # what are you doing
			  default {"Device Model:  "}
				}
			}
			if ($battery -and $modtype -eq "Device Model:  ") {
				$modtype = "Laptop Model:  "
			}
			if ($csysMan -and $csysModel) {
				Write-Output "$($resolvedosc)$modtype$($csysMan) $($csysModel)"
			} elseif ($csysMan) {
				Write-Output "$($resolvedosc)Manufacturer:  $($csysMan)"
			} elseif ($csysModel) {
				Write-Output "$($resolvedosc)$modtype$($csysModel)"
			}
		}
		if ($battery) {
			if ($battery.EstimatedChargeRemaining -ge 75) {$batcol = $($color.green)}
			elseif ($battery.EstimatedChargeRemaining -ge 50) {$batcol = $($color.yellow)}
			elseif ($battery.EstimatedChargeRemaining -ge 25) {$batcol = $($color.orange)}
			else {$batcol = $($color.red)}
			$bstatus = switch ($battery.BatteryStatus) {
				2 {"[AC Connected / Not Charging]"}
				6 {"[AC Connected / Charging]"}
				7 {"[AC Connected / Charging]"}
				8 {"[AC Connected / Charging]"}
				9 {"[AC Connected / Charging]"}
				10 {"[No Battery]"}
		default {""} # no info needed, can just read percentage
			}
			if ($bstatus -eq "[AC Connected / Not Charging]") {
				if ($batteryValueFallback) {
					if ($batteryValueFallback.Charging) {
						$bstatus = "[AC Connected / Charging]"
					} elseif ($batteryValueFallback.Discharging) {
						$bstatus = "[AC Connected / Discharging]"
					}
				}
			}
			Write-Output "$($resolvedosc)Battery:       $($batcol)$($battery.EstimatedChargeRemaining)`%$($resolvedosc) $bstatus"
		}
		$uptime = (Get-Date) - $script:osInfo.LastBootUpTime
		$uptimeParts = @()
		if ($uptime.Days    -gt 0) { $uptimeParts += "$($uptime.Days)d"    }
		if ($uptime.Hours   -gt 0) { $uptimeParts += "$($uptime.Hours)h"   }
		if ($uptime.Minutes -gt 0) { $uptimeParts += "$($uptime.Minutes)m" }
		$uptimeStr = if ($uptimeParts.Count -gt 0) { $uptimeParts -join " " } else { "0m" }
		Write-Output "$($resolvedosc)Uptime:        $uptimeStr$($color.reset)"
	} elseif ($IsLinux) {
		if ($bloat) {
			Write-output "$($resolvedosc)OS Class:      Unix-Like"
		}
		if ($Precise) {
			Write-output "$($resolvedosc)Kernel:        $(& uname -r)"
		} else {
			$kern = [System.Environment]::OSVersion.Version
			if (-not ($kern.Revision -ge 1)) {
				Write-output "$($resolvedosc)Kernel:        Linux $($kern.Major).$($kern.Minor).$($kern.Build)"
			} else {
				write-output "$($resolvedosc)Kernel:        Linux $($kern.Major).$($kern.Minor).$($kern.Build).$($kern.Revision)"
			}
		}
		if ($extra) {
			if (Get-Command hostname -ErrorAction SilentlyContinue) {
				$HostID = hostname
			} elseif ($env:HOSTNAME) {
				$HostID = $env:HOSTNAME
			} elseif (Test-Path /etc/hostname) {
				$HostID = (Get-Content /etc/hostname).Trim()
			}
			if ($env:USER) {
				$user = $env:USER
			} elseif ($env:LOGNAME) {
				$user = $env:LOGNAME
			} else {
				$user = whoami
			}
			Write-Output "$($resolvedosc)User:          $user@$HostID"
		}
		if ($ESVersionTable -and $Precise) {
			write-output "$($resolvedosc)Shell:         emberShell $($ESVersionTable.ESEdition) $($ESVersionTable.ESVersion) `($($PSVersionTable.PSEdition) $($PSVersionTable.PSVersion)`)"
		} elseif ($ESVersionTable) {
			write-output "$($resolvedosc)Shell:         emberShell $($ESVersionTable.ESEdition) $($ESVersionTable.ESVersion)"
		} elseif ($Precise) {
			write-output "$($resolvedosc)Shell:         PowerShell $($PSVersionTable.PSEdition) $($PSVersionTable.PSVersion)"
		} else {
			write-output "$($resolvedosc)Shell:         PowerShell $($PSVersionTable.PSEdition) $("$($PSVersionTable.PSVersion)".Substring(0,5))"
		}
		if ($pkgs) {
			$pkglines = @()
			if ($script:apt_count)      { $pkglines += "apt      - $script:apt_count" }
			if ($script:pacman_count)   { $pkglines += "pacman   - $script:pacman_count" }
			if ($script:rpm_count)      { $pkglines += "rpm      - $script:rpm_count" }
			if ($script:zypper_count)   { $pkglines += "zypper   - $script:zypper_count" }
			if ($script:flatpak_count)  { $pkglines += "flatpak  - $script:flatpak_count" }
			if ($script:snap_count)     { $pkglines += "snap     - $script:snap_count" }
			if ($script:brew_count)     { $pkglines += "brew     - $script:brew_count" }
			if ($script:nix_count)      { $pkglines += "nix      - $script:nix_count" }
			if ($script:xbps_count)     { $pkglines += "xbps     - $script:xbps_count" }
			if ($script:apk_count)      { $pkglines += "apk      - $script:apk_count" }
			if ($script:emerge_count)   { $pkglines += "emerge   - $script:emerge_count" }
			if ($script:opkg_count)     { $pkglines += "opkg     - $script:opkg_count" }
			if ($script:pacstall_count) { $pkglines += "pacstall - $script:pacstall_count" }
			if ($script:port_count)     { $pkglines += "port     - $script:port_count" }
			if ($script:pkg_count)      { $pkglines += "pkg      - $script:pkg_count" }
			if ($script:tazpkg_count)   { $pkglines += "tazpkg   - $script:tazpkg_count" }
			if ($script:equo_count)     { $pkglines += "equo     - $script:equo_count" }
			if ($script:guix_count)     { $pkglines += "guix     - $script:guix_count" }
			if ($script:slackpkg_count) { $pkglines += "slackpkg - $script:slackpkg_count" }
			if ($script:cave_count)     { $pkglines += "cave     - $script:cave_count" }
			if ($script:cpkg_count)     { $pkglines += "cpkg     - $script:cpkg_count" }
			if ($langpkgs) {
			if ($script:npm_count)     { $pkglines += "npm      - $script:npm_count" }
			if ($script:pip_count)     { $pkglines += "pip      - $script:pip_count" }
			if ($script:cargo_count)   { $pkglines += "cargo    - $script:cargo_count" }
			if ($script:gem_count)     { $pkglines += "gem      - $script:gem_count" }
			if ($script:luarocks_count){ $pkglines += "luarocks - $script:luarocks_count" }
			if ($script:psget_count)   { $pkglines += "psget    - $script:PSGet_count" }
			}
			if ($pkglines.Count -gt 0) {
				$label = "Packages:"
				foreach ($line in $pkglines) {
					write-output "$($resolvedosc)$($label.PadRight(15))$line"
					$label = ""  # blank after first line so label only prints once
				}
			}
		}
		if ($precise) {
			write-output "$($resolvedosc)Terminal:      $term $term_version"
		} else {
			write-output "$($resolvedosc)Terminal:      $term"
		}
		if ($term_font) {
			write-output "$($resolvedosc)Terminal Font: $term_font"
		}
		if ($de) {
			if ($precise) {
				Write-Output "$($resolvedosc)DE:            $de $de_version"
			} else {
				Write-Output "$($resolvedosc)DE:            $de"
			}
		}
		if ($wm) {
			if ($precise) {
				Write-Output "$($resolvedosc)WM:            $wm $wm_version"
			} else {
				Write-Output "$($resolvedosc)WM:            $wm"
			}
			if ($wm_theme) {
				Write-Output "$($resolvedosc)WM Theme:      $wm_theme"
			}
		}
		if ($theme) {
			Write-Output "$($resolvedosc)Theme:         $theme"
		}
		if ($sys_font) {
			Write-Output "$($resolvedosc)System Font:   $sys_font"
		}
		if ($cursor) {
			Write-Output "$($resolvedosc)Cursor:        $cursor"
		}
		$cpu = (lscpu | Select-String "Model name").ToString().Split(":")[1].Trim()
		Write-Output "$($resolvedosc)CPU:           $cpu"
		$base = $null
		$boost = $null
		$mhzLine = lscpu | Select-String "CPU max MHz"
		if (-not $mhzLine) { $mhzLine = lscpu | Select-String "CPU MHz" }
		if ($mhzLine) {
			$base = [math]::Round([double]($mhzLine.Line.Split(":")[1].Trim()))
		} else {
			$freqPath = "/sys/devices/system/cpu/cpu0/cpufreq/base_frequency"
			if (Test-Path $freqPath) {
				$base = [math]::Round((Get-Content $freqPath) / 1000)
			}
		}
		$boostPath = "/sys/devices/system/cpu/cpu0/cpufreq/cpuinfo_max_freq"
		if (Test-Path $boostPath) {
			$boost = [math]::Round((Get-Content $boostPath) / 1000)
		}
		if ($base) {
			Write-Output "$($resolvedosc)CPU Base:      ${base}MHz"
		}
		if ($boost) {
			Write-Output "$($resolvedosc)CPU Boost:     ${boost}MHz"
		}
		$cores = (nproc)
		$threads = (lscpu | Select-String "^CPU\(s\):").ToString().Split(":")[1].Trim()
		if ($bloat) {
			$architecture = uname -m
			$bits = switch ($architecture) {
				"x86"    { "32-bit" }
				"ARM"    { "32-bit" }
				"armv7l" { "32-bit" }
				"i386"   { "32-bit" }
				"i486"   { "32-bit" }
				"i586"   { "32-bit" }
				"i686"   { "32-bit" }
				default  { "64-bit" }
			}
			if ($architecture -eq "x86_64") {$architecture = "AMD64"}
			Write-Output "$($resolvedosc)Architecture:  $architecture ($bits)"
		}
		Write-Output "$($resolvedosc)CPU Cores:     $cores"
		Write-Output "$($resolvedosc)CPU Threads:   $threads"
		$gpuLine = lspci | Select-String -Pattern "VGA|3D" | Select-Object -First 1
		if ($gpuLine) {
			$gpu = $gpuLine.ToString().Split(":")[2].Trim()
			$pciSlot = $gpuLine.ToString().Split(" ")[0].Trim()
			$isIGPU = $false
			if ($gpu -match "Intel") {
				$isIGPU = $pciSlot -match "^00:02\.0" # thx intel
			} elseif ($gpu -match "AMD|ATI") {
				$card = Get-ChildItem /sys/class/drm | Where-Object { $_.Name -match "^card\d+$" } | Select-Object -First 1
				if ($card) {
					$hwmon = Get-ChildItem "$($card.FullName)/device/hwmon" -ErrorAction SilentlyContinue | Select-Object -First 1
					$isIGPU = $hwmon -and (Test-Path "$($hwmon.FullName)/in1_input")
				}
			}	
			if ($isIGPU) {
				if ($precise) {
					$memInfoRam = [int]((Get-Content /proc/meminfo | Select-String "MemTotal").ToString() -replace "[^0-9]")
					$dmidecode = dmidecode -t memory 2>/dev/null | Select-String "Size:" | Where-Object { $_ -notmatch "No Module" }
					$totalMB = if ($dmidecode) {
						($dmidecode | ForEach-Object {
							if ($_ -match "(\d+)\s+GB") { [int]$Matches[1] * 1024 }
							elseif ($_ -match "(\d+)\s+MB") { [int]$Matches[1] }
						} | Measure-Object -Sum).Sum
					} else { [math]::Round($memInfoRam / 1024, 0) }
					$visibleMB = [math]::Round($memInfoRam / 1024, 0)
					$reservedMB = $totalMB - $visibleMB
					if ($reservedMB -gt 1024) {
						$usageigpu = "($([math]::Round($reservedMB / 1024, 0))`GB)"
					} else {
						$usageigpu = "($reservedMB`MB)"
					}
				} else { $usageigpu = "" }
				$type = "[Integrated] $usageigpu".Trim()
			} else { $type = "" }
			Write-Output "$($resolvedosc)GPU:           $gpu $type"
		}
		$memInfo = Get-Content /proc/meminfo
		$memKb = ($memInfo | Where-Object { $_ -match '^MemTotal' }) -replace '[^0-9]'
		$memAvailableKb = [long](($memInfo | Where-Object { $_ -match '^MemAvailable' }) -replace '[^0-9]')
		$ramGb = [long]$memKb / 1024 / 1024
		$usedRam = [math]::Round(([long]$memKb - $memAvailableKb) / 1024 / 1024, 1)
		$totalRam = [math]::Round([long]$memKb / 1024 / 1024, 1)
		$sizeStr = if ($ramGb -ge 1) { "$([math]::Round($ramGb))GB" } else { "$([math]::Round($ramGb * 1024))MB" }
		$ramUsageStr = "${usedRam}GB/${totalRam}GB"
		$dmiRaw = $null
		$ramPercent = [math]::Round(($usedRam / $totalRam) * 100)
		if ($ramPercent -ge 75) {
			$col = $($color.red)
		} elseif ($ramPercent -ge 50) {
			$col = $($color.yellow)
		} else {
			$col = $($color.green)
		}
		if (Get-Command dmidecode -ErrorAction SilentlyContinue) {
			$dmiRaw = dmidecode -t 17 2>/dev/null
			if ($LASTEXITCODE -ne 0) { $dmiRaw = $null }
		}
		if ($dmiRaw) {
			$type  = $dmiRaw | Select-String "^\s*Type:"  | Select-Object -First 1 | ForEach-Object { ($_ -split ":\s*")[1].Trim() }
			$speed = $dmiRaw | Select-String "^\s*Speed:" | Select-Object -First 1 | ForEach-Object { ($_ -split ":\s*")[1].Trim() }
			$ff    = $dmiRaw | Select-String "^\s*Form Factor:" | Select-Object -First 1 | ForEach-Object { ($_ -split ":\s*")[1].Trim() }
			$mmf    = $dmiRaw | Select-String "^\s*Manufacturer:" | Select-Object -First 1 | ForEach-Object { ($_ -split ":\s*")[1].Trim() }
			if ($precise) {
				if ($bloat) {
					Write-Output "$($resolvedosc)RAM:           $mmf $sizeStr $ff $type $speed"
				} else {
					Write-Output "$($resolvedosc)RAM:           $sizeStr $ff $type $speed"
				}
			} else {
				if ($bloat) {
					Write-Output "$($resolvedosc)RAM:           $mmf $sizeStr $type $speed"
				} else {
					Write-Output "$($resolvedosc)RAM:           $sizeStr $type $speed"
				}
			}
		} else {
			Write-Output "$($resolvedosc)RAM:           $sizeStr"
		}
		write-output "$($resolvedosc)RAM Usage:     $ramUsageStr ($col$rampercent`%$($resolvedosc))"
		$swapInfo = Get-Content /proc/meminfo
		$swapTotalKb = [long](($swapInfo | Where-Object { $_ -match '^SwapTotal' }) -replace '[^0-9]')
		$swapFreeKb  = [long](($swapInfo | Where-Object { $_ -match '^SwapFree' }) -replace '[^0-9]')
		$swapUsedKb  = $swapTotalKb - $swapFreeKb
		$swapTotal = [math]::Round($swapTotalKb / 1024 / 1024, 1)
		$swapUsed  = [math]::Round($swapUsedKb  / 1024 / 1024, 1)
		$swapPercent = if ($swapTotalKb -gt 0) { [math]::Round(($swapUsedKb / $swapTotalKb) * 100) } else { 0 }
		if ($swapPercent -ge 75) { $swapCol = $($color.red) }
		elseif ($swapPercent -ge 50) { $swapCol = $($color.yellow) }
		else { $swapCol = $($color.green) }
		if ($swapTotalKb -gt 0) {
			Write-Output "$($resolvedosc)Swap:          ${swapUsed}GB/${swapTotal}GB `($swapCol$swapPercent%$($resolvedosc))"
		}
		$disks = lsblk -dn -o NAME,SIZE,ROTA --bytes | Where-Object { $_ -match "^\s*(sd[a-z]|nvme|vd|hd)" }
		$prefix = "Storage:       "
		$indent = " " * $prefix.Length
		$first = $true
		foreach ($d in $disks) {
			$parts = $d -split "\s+" | Where-Object { $_ -ne "" }
			$name  = $parts[0]
			$bytes = [long]$parts[1]
			$rota  = $parts[2]
			$sizeStr = if ($bytes -ge 1000000000000) { "$([math]::Round($bytes / 1000000000000, 1))TB" }
				elseif ($bytes -ge 1000000000) { "$([math]::Round($bytes / 1000000000))GB" }
				else { "$([math]::Round($bytes / 1000000))MB" }
			$label = if ($name -match "^nvme") { "NVMe SSD" }
				elseif ($name -match "^sd" -and $rota -eq "0") { "SATA SSD" }
				elseif ($rota -eq "1") { "HDD" }
				else { "SSD" }
			$line = if ($first) { $prefix } else { $indent }
			Write-Output "$($resolvedosc)$line$sizeStr $label"
			$first = $false
		}
		if ($DiskUsage) {
			$ldPrefix = "$($resolvedosc)Storage Usage: "
			$ldIndent = "$($resolvedosc)               "
			$firstLd = $true
			$dfLines = (& df -T -x tmpfs -x devtmpfs -x squashfs --block-size=1 2>$null) | Select-Object -Skip 1
			foreach ($line in $dfLines) {
				$parts = $line -split '\s+', 7
				if ($parts.Count -lt 7) { continue }
				$fs      = $parts[1]
				$total   = [long]$parts[2]
				$used    = [long]$parts[3]
				$mount   = $parts[6].Trim()
				$diskpercent = if ($total -gt 0) { [math]::Round(($used / $total) * 100) } else { 0 }
				$usedStr  = if ($used  -ge 1000000000000) { "$([math]::Round($used  / 1000000000000, 1))TB" }
							else { "$([math]::Round($used  / 1000000000, 1))GB" }
				$totalStr = if ($total -ge 1000000000000) { "$([math]::Round($total / 1000000000000, 1))TB" }
							else { "$([math]::Round($total / 1000000000, 1))GB" }
				$col = if ($diskpercent -ge 75) { $color.red } elseif ($diskpercent -ge 50) { $color.yellow } else { $color.green }
				$entry = "$mount $usedStr/$totalStr ($($col)$diskpercent%$($resolvedosc)) $fs"
				if ($firstLd) {
					Write-output "$($ldPrefix)$entry"
					$firstLd = $false
				} else {
					Write-output "$($ldIndent)$entry"
				}
			}
		}
		if (Test-Path "/sys/class/dmi/id/board_vendor") {
			$vendor = Get-Content /sys/class/dmi/id/board_vendor
			$name = Get-Content /sys/class/dmi/id/board_name
			Write-Output "$($resolvedosc)Motherboard:   $vendor $name"
		}
		if ($extra) {
			$csysMan   = (Get-Content /sys/class/dmi/id/sys_vendor       -ErrorAction SilentlyContinue)?.Trim()
			$csysModel = (Get-Content /sys/class/dmi/id/product_name     -ErrorAction SilentlyContinue)?.Trim()
			$chassis   = (Get-Content /sys/class/dmi/id/chassis_type     -ErrorAction SilentlyContinue)?.Trim()
			$modtype = switch ($chassis) {
				"3"  { "Desktop Model: " }
				"4"  { "Desktop Model: " }
				"6"  { "Desktop Model: " }
				"7"  { "Desktop Model: " }
				"8"  { "Laptop Model:  " }
				"9"  { "Laptop Model:  " }
				"10" { "Laptop Model:  " }
				"11" { "Laptop Model:  " }
				"14" { "Laptop Model:  " }
				"17" { "Server Model:  " }
				"23" { "Server Model:  " }
				"28" { "Tablet Model:  " }
				"31" { "Tablet Model:  " }
				default { "Device Model:  " }
			}
			if ($batDir -and $modtype -eq "Device Model:  ") {
				$modtype = "Laptop Model:  "
			}
			if ($csysMan -and $csysModel) {
				Write-Output "$($resolvedosc)$modtype$csysMan $csysModel"
			} elseif ($csysMan) {
				Write-Output "$($resolvedosc)Manufacturer:  $csysMan"
			} elseif ($csysModel) {
				Write-Output "$($resolvedosc)$modtype$csysModel"
			}
		}
		$batPath = "/sys/class/power_supply"
		$batDir = Get-ChildItem $batPath | Where-Object { $_.Name -match "^BAT" } | Select-Object -First 1
		if ($batDir) {
			$batPercent = [int](Get-Content "$batPath/$($batDir.Name)/capacity" -ErrorAction SilentlyContinue)
			$batStatus  = (Get-Content "$batPath/$($batDir.Name)/status" -ErrorAction SilentlyContinue)?.Trim()
			if ($batPercent -ge 75)    { $batcol = $($color.green)  }
			elseif ($batPercent -ge 50) { $batcol = $($color.yellow) }
			elseif ($batPercent -ge 25) { $batcol = $($color.orange) }
			else                        { $batcol = $($color.red)    }
			$acDir = Get-ChildItem $batPath | Where-Object { $_.Name -match "^A[C]|^ACAD" } | Select-Object -First 1
			$acOnline = if ($acDir) { [int](Get-Content "$batPath/$($acDir.Name)/online" -ErrorAction SilentlyContinue) } else { 0 }
			$bstatus = switch ($batStatus) {
				"Charging"     {"[AC Connected / Charging]"}
				"Not charging" { if ($acOnline) { "[AC Connected / Not Charging]" } else { "" } }
				"Full"         { if ($acOnline) { "[AC Connected / Not Charging]" } else { "" } }
				"Discharging"  { if ($acOnline) { "[AC Connected / Discharging]"  } else { "" } }
				default        { "" }
			}
			Write-Output "$($resolvedosc)Battery:       $($batcol)$($batPercent)`%$($resolvedosc) $bstatus"
		}
		$raw = [double](Get-Content /proc/uptime).Split()[0]
		$ts = [timespan]::FromSeconds($raw)
		$parts = @()
		if ($ts.Days)    { $parts += "$($ts.Days)d" }
		if ($ts.Hours)   { $parts += "$($ts.Hours)h" }
		if ($ts.Minutes) { $parts += "$($ts.Minutes)m" }
		$uptime = if ($parts) { $parts -join " " } else { "0m" }
		Write-Output "$($resolvedosc)Uptime:        $uptime"
	} elseif ($IsMacOS) {
		<# write-output "cfetch is untested on MacOS.`nrunning it may cause issues or report false system information.`nrun anyways?`n$($color.green)y$($color.reset)/$($color.red)n$($color.reset)"
		$yn = (confirm "runanyways" "y" "n")
		if ($yn) {
			if ($Precise) {
				Write-output "$($resolvedosc)Kernel:        $(& uname -r)"
			} else {
				$kern = [System.Environment]::OSVersion.Version
				if (-not ($kern.Revision -ge 1)) {
					Write-output "$($resolvedosc)Kernel:        XNU $($kern.Major).$($kern.Minor).$($kern.Build)"
				} else {
					write-output "$($resolvedosc)Kernel:        XNU $($kern.Major).$($kern.Minor).$($kern.Build).$($kern.Revision)"
				}
			}
			if ($ESVersionTable -and $Precise) {
				write-output "$($resolvedosc)Shell:         emberShell $($ESVersionTable.ESEdition) $($ESVersionTable.ESVersion) `($($PSVersionTable.PSEdition) $($PSVersionTable.PSVersion)`)"
			} elseif ($ESVersionTable) {
				write-output "$($resolvedosc)Shell:         emberShell $($ESVersionTable.ESEdition) $($ESVersionTable.ESVersion)"
			} elseif ($Precise) {
				write-output "$($resolvedosc)Shell:         PowerShell $($PSVersionTable.PSEdition) $($PSVersionTable.PSVersion)"
			} else {
				write-output "$($resolvedosc)Shell:         PowerShell $($PSVersionTable.PSEdition) $("$($PSVersionTable.PSVersion)".Substring(0,5))"
			}
			if ($precise) {
				write-output "$($resolvedosc)Terminal:      $term $term_version"
			} else {
				write-output "$($resolvedosc)Terminal:      $term"
			}
			if($cursor) {
				Write-Output "$($resolvedosc)Cursor:        $cursor"
			}
			$cpu = sysctl -n machdep.cpu.brand_string
			$cores = sysctl -n hw.physicalcpu
			$threads = sysctl -n hw.logicalcpu
			Write-Output "$($resolvedosc)CPU:           $cpu"
			Write-Output "$($resolvedosc)CPU Cores:     $cores"
			Write-Output "$($resolvedosc)CPU Threads:   $threads"
			Write-Output "$($resolvedosc)CPU Base:      unsupported on macos"
			$ram = (sysctl -n hw.memsize) / 1GB
			Write-Output "$($resolvedosc)RAM:           $([math]::Round($ram,1))GB"
			Write-Output "$($resolvedosc)RAM Detail:    unsupported on macos"
			$gpuLine = system_profiler SPDisplaysDataType | Select-String "Chipset Model" | Select-Object -First 1
			if ($gpuLine) {
				$gpu = $gpuLine.ToString().Split(":")[1].Trim()
				Write-Output "$($resolvedosc)GPU:           $gpu"
			} else {
				Write-Output "$($resolvedosc)GPU:           unsupported on macos"
			}
			$disk = (df -h / | Select-Object -Last 1).Split()[1]
			Write-Output "$($resolvedosc)Storage:       $disk"
			Write-Output "$($resolvedosc)Storage Type:  unsupported on macos" # if you care about mac support a LOT a lot then.. PR pls
			Write-Output "$($resolvedosc)Motherboard:   unsupported on macos" # mac support is so scuffed.. we might as well drop it
			$uptimeRaw = uptime
			$uptime = (($uptimeRaw -split "up ")[1] -split ",")[0]
			Write-Output "$($resolvedosc)Uptime:        $uptime"
		}#>
		invoke-panic "cfetch does not support MacOS."
	}
	if ($locale) {
			if ($PSCulture -and $PSUICulture) {
				write-output "$($resolvedosc)Locale:        $PSCulture$($color.reset)"
				write-output "$($resolvedosc)Language:      $PSUICulture$($color.reset)"
			} elseif ($host) {
				write-output "$($resolvedosc)Locale:        $($host.CurrentCulture)$($color.reset)"
				write-output "$($resolvedosc)Language:      $($host.CurrentUICulture)$($color.reset)"
			}
	}
	# cdump # not needed in backend recode
} # cfetch is over a thousand lines... jeez...

# legacfetch -> legacy/backend of cfetch
# cfetch's new frontend is internally called neocfetch

function cfetch($larp, [switch]$precise, [switch]$bloat, [switch]$clean, [switch]$extra, [switch]$locale, [switch]$diskusage, [switch]$pkgs, [switch]$winget, [switch]$langpkgs) {
    if ($clean) { Clear-Host }

    $data = legacfetch $larp -precise:$precise -bloat:$bloat -extra:$extra -locale:$locale -diskusage:$diskusage -pkgs:$pkgs -winget:$winget -langpkgs:$langpkgs -backend
    $infoLines = $data -split "`n"

    $osKey = ($infoLines | Where-Object { $_ -match "^OSKey:" }) -replace "OSKey:\s+", ""
    $infoLines = $infoLines | Where-Object { $_ -notmatch "^OSKey:" }

    $resolvedosc = resolveOSC $osKey
    $logoName = if ($osKey -notin $validOSes) { "fetch_unknown_os" } else { $osKey }
    $logoRaw = render $logoName
    $logoLines = $logoRaw -split "`n"
    $maxLogoWidth = ($logoLines | ForEach-Object { ($_ -replace '\x1b\[[0-9;]*[mGKHF]', '').Length } | Measure-Object -Maximum).Maximum
    $cursorColumn = $maxLogoWidth + 4

    Write-Host $logoRaw
    $moveUp = $logoLines.Count
    Write-Host "`e[${moveUp}A" -NoNewline

    $lastLogoColor = $null
    for ($j = $logoLines.Count - 1; $j -ge 0; $j--) {
        $match = [regex]::Match($logoLines[$j], '^\x1b\[[0-9;]*m')
        if ($match.Success) { $lastLogoColor = $match.Value; break }
    }
    $currentColor = if ($lastLogoColor) { $lastLogoColor } else { $resolvedosc }

    for ($i = 0; $i -lt $infoLines.Count; $i++) {
        if ($i -lt $logoLines.Count) {
            $match = [regex]::Matches($logoLines[$i], '\x1b\[[0-9;]*m') | Select-Object -Last 1
            if ($match.Success) { $currentColor = $match.Value }
        }
        $strippedLine = $infoLines[$i] -replace '^\x1b\[[0-9;]*m', ''
        $strippedLine = $strippedLine -replace [regex]::Escape($resolvedosc), $currentColor
        Write-Host "`e[${cursorColumn}G$currentColor$strippedLine"
    }
    Write-Host $color.reset
}

function hyperc($larp, [switch]$clean, [switch]$winget, [switch]$langpkgs) {
	if ($larp) {
		if (-not $clean) {
			cfetch $larp -precise -bloat -extra -locale -diskusage -pkgs -winget:$winget -langpkgs:$langpkgs
		} else {
			cfetch $larp -precise -bloat -extra -locale -diskusage -pkgs -winget:$winget -langpkgs:$langpkgs -clean
		}
	} else {
		if (-not $clean) {
			cfetch -precise -bloat -extra -locale -diskusage -pkgs -winget:$winget -langpkgs:$langpkgs
		} else {
			cfetch -precise -bloat -extra -locale -diskusage -pkgs -winget:$winget -langpkgs:$langpkgs -clean
		}
	}
}
Export-ModuleMember -Variable CLVersionTable
Export-ModuleMember -Variable color
Export-ModuleMember -Variable time
Export-ModuleMember -Variable esc
Export-ModuleMember -Variable validOSes
Export-ModuleMember -Function *

