function htaTool {
    param(
        [Parameter(Mandatory)]
        [string]$Hex
    )

    $Hex = $Hex.TrimStart("#")

    if ($Hex.Length -ne 6) {
        throw "Invalid hex color: $Hex (expected #RRGGBB)"
    }

    $r = [Convert]::ToInt32($Hex.Substring(0,2),16)
    $g = [Convert]::ToInt32($Hex.Substring(2,2),16)
    $b = [Convert]::ToInt32($Hex.Substring(4,2),16)

	if (!$clibConfig.DisableANSI -or !$clibConfig.DisableTrueColor) {
		write-output "${esc}[38;2;$r;$g;${b}m`${esc}[38;2;$r;$g;${b}m"
	} else {
		write-output "`${esc}[38;2;$r;$g;${b}m"
	}
}

function htaToolPure {
    param(
        [Parameter(Mandatory)]
        [string]$Hex
    )

    $Hex = $Hex.TrimStart("#")

    if ($Hex.Length -ne 6) {
        throw "Invalid hex color: $Hex (expected #RRGGBB)"
    }

    $r = [Convert]::ToInt32($Hex.Substring(0,2),16)
    $g = [Convert]::ToInt32($Hex.Substring(2,2),16)
    $b = [Convert]::ToInt32($Hex.Substring(4,2),16)
	if (!$clibConfig.DisableANSI -or !$clibConfig.DisableTrueColor) {
		return "${esc}[38;2;$r;$g;${b}m"
	}
}


