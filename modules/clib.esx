function initlog {
	param(
		[int]$status = 0,
		[string]$message = ""
	)
	if ($status -eq 0) {
		write-host "[   " -n
		write-host "OK" -n -fo gre
		write-host "   ] {$message}`n" -n
	} elseif ($status -eq 1) {
		write-host "[  " -n
		write-host "INFO" -n -fo blu
		write-host "  ] {$message}`n" -n
	} elseif ($status -eq "3") {
		write-host "[  " -n
		write-host "ERROR" -n -fo r
		write-host " ] {$message}`n" -n
	} elseif ($status -eq "2") {
		write-host "[  " -n
		write-host "WARN" -n -fo y
		write-host "  ] {$message}`n" -n
	}
}

$clibManifest = @{
	esx = $true
    fork = $false
	dev_name = "cereal"
	ver_name = "steamy"
	version = "1.6"
	lib_name = "clib"
} # CLIBMANIFEST WILL BE KILLED IN 2.0!
# USE CLVersionTable INSTEAD!
$CLVersionTable = [ordered]@{
	CLVersion = [System.Version]"1.7"
	CLEdition = "Steamy"
	esx       = $true
	fork      = $false
	dev       = "cereal"
}
sv -n CLVersionTable -o r  # make cl ver table immutable // this may cause issues if undone

# 0.1 - 0.9 -> flake
# 1.0 - 1.2 -> oats
# 1.3       -> crunch
# 1.4 - 1.5 -> sugar
# 1.6 - 1.8 -> steamy

if (test-path (join-path $global:eShScriptRoot "clib.rice")) {
	$clibConfig = (join-path $global:eShScriptRoot "clib.rice")
} else {
	"{
		`"DisableTrueColor`": false,
		`"DisableANSI`": false,
		`"SilentISE`": false
	}" > (join-path $global:eShScriptRoot "clib.rice")
	if (test-path (join-path $global:eShScriptRoot "clib.rice")) {
		$clibConfig = (join-path $global:eShScriptRoot "clib.rice")
	} else {
		write-host "clib: couldn't find clib.rice`nclib: couldn't create clib.rice" -fo r 
	}
}

function set-clibconfig($key, $value) {
    $path = "$global:eShScriptRoot/clib.rice"
    $config = if (Test-Path $path) { Get-Content $path -Raw | ConvertFrom-Json -AsHashtable } else { @{} }
    $config[$key] = $value
    $config | ConvertTo-Json | Set-Content $path
	$clibConfig = $path
}

function confirm($content, $y, $n, $default) {
	write-host "$content`n[$y/$n]"
	$answer = read-host
	if ($answer -eq $y) {
		return $true
	} elseif ($answer -eq $n) {
		return $false
	} else {
		return $default
	}
}

if ($PSISE) {
	if (!$clibConfig.SilentISE) {
		write-host "Detected PowerShell ISE variable..."
		warn "PowerShell ISE doesn't support ANSI."
		$dANSI = confirm "Disable ANSI?" Y n $true
		if ($dANSI) {
			set-clibconfig DisableANSI $true
		}
	}
}

function warn($str, [switch]$disablepref) {
	if (!$disablepref) {
		write-host "<`!>$str" -fo y
	} else {
		write-host $str -fo y
	}
}

function random($min, $max) {
	return Get-Random -minimum $min -maximum ($max + 1)
}

function idx($array, $num) {
	$array[($num-1)]
}

function cnr($files, $output, $names, [switch]$pname, [switch]$log) {
$iterator = 0
$findex = $files.count
$nmindex = $names.count
$allowed = -1
	if ($findex -gt $nmindex) {
		$allowed = 0
	} elseif ($findex -le $nmindex) {
		$allowed = 1
	}
	if ($allowed -eq 1) {
		if ($pname) {
			foreach ($file in $files) {
				$iterator += 1
				$iname = idx $names $iterator
				$dest = $output + $iname
				Copy-Item $file -Destination $dest
				if ($log) {
					write-output "copied $file to $dest"
				}
			}
		} else {
			foreach ($name in $names) {
				$iterator += 1
				$ifile = idx $files $iterator
				$dest = $output + $name
				Copy-Item $ifile -Destination $dest
				if ($log) {
					write-output "copied $ifile to $dest"
				}
			}
		}
	} elseif ($allowed -eq 0) {
		throw "forbidden action, more files than filenames.`n$findex files`n$nmindex filenames`nusing the -pname flag could fix this."
	} else {
		throw "unexpected error. `$allowed = $allowed,`nbinary expected."
	}
}

$time = @{
    clock = {get-date -format "HH:mm"}
	wclock = {get-date -format "HH:mm:ss"}
	msprecise = {get-date -format "HH:mm:ss.fff"}
	tickprecise = {get-date -format "HH:mm:ss.fffffff"}
	clock12 = {get-date -format "hh:mm tt"}
	wclock12 = {get-date -format "hh:mm:ss tt"}
	msprecise12 = {get-date -format "hh:mm:ss.fff tt"}
	tickprecise12 = {get-date -format "hh:mm:ss.fffffff tt"}
	date = {get-date -format "dd.MM.yyyy"}
	usdate = {get-date -format "MM/dd/yyyy"}
	isodate = {get-date -format "yyyy-MM-dd"}
	era = {get-date -format "gg"}
	# shortera = {get-date -format "g"} # this does not work
}

function get-logtime($fmt) {
    if($fmt) {
		return &$time[$fmt]
	}
    return &$time.wclock
}

function write-log($text, $fmt, $type) {
	$logtime = get-logtime $fmt
	if ($type -eq "throw") {
		throw "[$logtime]: $text"
	}elseif ($type -eq "error") {
		write-error "[$logtime]: $text"
	}elseif ($type -eq "softthrow") {
	softthrow "[$logtime]: $text"
	} else {
		write-output "[$logtime]: $text"
	}
}

function uac {
	if (-not ([Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) {
		Start-Process powershell -Verb RunAs -ArgumentList "-NoExit -File `"$PSCommandPath`""
		exit
	}
}

function timed($func) {
    $start = Get-Date
    &$func
    $end = Get-Date
    return ($end - $start)
}

function force($func, $expect, $att, [switch]$silent) {
	$iterator = 0
	if ($att) {
		do {
			$result = &$func
			$iterator += 1
		} while ($iterator -lt $att -and $expect -ne $result)
		if(-not $silent){
			if ($expect -eq $result) {
				write-output "$func succeeded after $iterator attempts."
			} else {
				throw "$func failed to force."
			}
		}
	} else {
		do {
			$result = &$func
			$iterator += 1
		} while ($expect -ne $result)
		if(-not $silent){
			write-output "$func succeeded after $iterator attempts."
		}
	}
}

function clamp($value, $min, $max) {
	if ($value -gt $max) {
		$value = $max
	} elseif ($value -lt $min) {
		$value = $min
	}
	return $value
}

function repstring($string, $reps, $fmt) {
	$iterator = 0
	if ($fmt) {
		if ($fmt -eq "count") {
			while ($iterator -lt $reps) {
				$output = $output + "$($iterator + 1). $string`n"
				$iterator += 1
			}
		} elseif ($fmt -eq "append") {
			$output = $string * $reps
		} elseif ($fmt -eq "list") {
			while ($iterator -lt $reps) {
				$output = $output + "- $string`n"
				$iterator += 1
			}
		}
	} else {
		while ($iterator -lt $reps) {
				$output = $output + "$string`n"
				$iterator += 1
			}
	}
	return $output
}

function fuck($reps, [switch]$log) {
	$iterator = 0
	if (-not $reps) {
		if ($log) {
			write-log "fuck" -type "error"
		} else {
			write-error "fuck"
		}
	}
	if ($log) {
		while ($iterator -lt $reps) {
			write-log "fuck" -type "error"
			$iterator += 1
		}
	} else {
		while ($iterator -lt $reps) {
			write-error "fuck"
			$iterator += 1
		}
	}
}
