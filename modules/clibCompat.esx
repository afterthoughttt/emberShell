	}elseif($type -eq "win10_fetch") {
		write-output "$($color.win11)`n                                    ███████`n                       ████████████████████`n          ███████   ███████████████████████`n█████████████████   ███████████████████████`n█████████████████   ███████████████████████`n█████████████████   ███████████████████████`n█████████████████   ███████████████████████`n█████████████████   ███████████████████████`n█████████████████   ███████████████████████`n█████████████████   ███████████████████████`n█████████████████   ███████████████████████`n`n`n█████████████████   ███████████████████████`n█████████████████   ███████████████████████`n█████████████████   ███████████████████████`n█████████████████   ███████████████████████`n█████████████████   ███████████████████████`n█████████████████   ███████████████████████`n█████████████████   ███████████████████████`n█████████████████   ███████████████████████`n          ███████   ███████████████████████`n                        ███████████████████`n                                     ██████`n$($color.reset)"
	}elseif($type -eq "win_fetch") {
		write-output "`n`n$($color.afterthought)          ██████████████▄`n$($color.afterthought)         ████████████████▄`n$($color.afterthought)         █████████████████ $($color.mint)███▄          ▄██`n$($color.afterthought)        ██████████████████ $($color.mint)██████████████████`n$($color.afterthought)        █████████████████  $($color.mint)█████████████████`n$($color.afterthought)       █████████████████  $($color.mint)██████████████████`n$($color.afterthought)       █████████████████ $($color.mint)██████████████████`n$($color.afterthought)      █████████████████  $($color.mint)██████████████████`n$($color.afterthought)                   ▀▀█  $($color.mint)██████████████████`n$($color.win10)     ███████████████   $($color.mint)██████████████████`n$($color.win10)     ████████████████    $($color.mint)▀██████████████▀`n$($color.win10)    ████████████████  $($color.yellow)███▄`n$($color.win10)   ████████████████  $($color.yellow)███████████████████`n$($color.win10)   █████████████████ $($color.yellow)██████████████████`n$($color.win10)  █████████████████  $($color.yellow)█████████████████`n$($color.win10)  █████████████████ $($color.yellow)██████████████████`n$($color.win10) █████████████████  $($color.yellow)██████████████████`n$($color.win10)  █▀           ██▀ $($color.yellow)██████████████████`n$($color.yellow)                   ██████████████████`n$($color.yellow)                     ███████████████▀`n					$($color.reset)" # handmade by cereal <3
