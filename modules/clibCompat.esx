function clib([switch]$version, [switch]$fork, [switch]$dev, [switch]$vername, [switch]$libname, [switch]$esx, [switch]$wm) {
	if($wm){
		watermark clib
	}
	if($libname){
		if($clibManifest.fork -eq $false) {
			watermark clib
		} else {
			write-output $($clibManifest).lib_name
		}
	}
	if($version){
		write-output $($clibManifest).version
	}
	if($vername){
		write-output $($clibManifest).ver_name
	}
	if($dev){
		write-output "by" $($clibManifest).dev_name
	}
	if($fork){
		if($clibManifest.fork -eq $true){
			write-output "is a fork"
		}else{
			write-output "not a fork"
		}
	}
	if($esx){
		if($clibManifest.esx -eq $true){
			write-output "esx build"
		}else{
			write-output "psm1 build"
		}
	}
}

function Get-OSKey {
    $os = [System.Runtime.InteropServices.RuntimeInformation]::OSDescription
    if ($os -match "Windows") {
        $caption = (Get-CimInstance Win32_OperatingSystem).Caption
        if ($caption -match "Windows 11") { return "win11_fetch" }
        elseif ($caption -match "Windows 10") { return "win10_fetch" }
        else { return "win_fetch" }
    }
    elseif ($os -match "Linux") {
        if (-not (Test-Path /etc/os-release)) {
            return "tux"
        }
        $osInfo = Get-Content /etc/os-release | ConvertFrom-StringData
        $id = $osInfo.ID.ToLower()
        switch ($id) {
            "arch"      { return "arch" } # btw
            "linuxmint" { return "mint" }
            "debian"    { return "debian" }
            "ubuntu"    { return "ubuntu" }
            "pop"       { return "pop" }
            default      { return "tux" }
        }
    }
    elseif ($os -match "Darwin") {
        return "mac"
    }
    return "fetch_unknown_os"
}
$validOSes = @("win_fetch", "win10_fetch", "win11_fetch", "arch", "mint", "pop", "tux", "ubuntu", "debian", "mac", "cerealos")
function cfetch($larp) {
	if ($larp) {
		if ($larp -notin $validOSes) {
		render "fetch_unknown_os"
		} else {
			render $larp
		}
		if ($larp -eq "win_fetch") {
			write-output "$($color.win10)Windows"
		} elseif ($larp -eq "win10_fetch") {
			write-output "$($color.win10)Windows 10"
		} elseif ($larp -eq "win11_fetch") {
			write-output "$($color.win11)Windows 11"
		} elseif ($larp -eq "arch") {
			write-output "$($color.win11)Arch" # btw
		} elseif ($larp -eq "mint") {
			write-output "$($color.mint)Linux Mint"
		} elseif ($larp -eq "debian") {
			write-output "$($color.debian)Debian"
		} elseif ($larp -eq "pop") {
		write-output "$($color.pop)Pop!_OS"
		} elseif ($larp -eq "tux") {
			write-output "$($color.orange)Linux"
		} elseif ($larp -eq "ubuntu") {
			write-output "$($color.orange)Ubuntu"
		} elseif ($larp -eq "mac") {
			write-output "$($color.indigo)MacOS"
		} elseif ($larp -eq "cerealos") {
			write-output "$($color.pink)CerealOS"
		} else {
			write-output "$($color.violet)$larp"
		}
	} else {
		$logo = Get-OSKey
		if ($logo -notin $validOSes) {
			render "fetch_unknown_os"
		} else {
			render $logo
		}
		if ($logo -eq "win_fetch") {
			write-output "$($color.win10)Windows"
		} elseif ($logo -eq "win10_fetch") {
			write-output "$($color.win10)Windows 10"
		} elseif ($logo -eq "win11_fetch") {
			write-output "$($color.win11)Windows 11"
		} elseif ($logo -eq "arch") {
			write-output "$($color.win11)Arch" # btw
		} elseif ($logo -eq "mint") {
			write-output "$($color.mint)Linux Mint"
		} elseif ($logo -eq "debian") {
			write-output "$($color.debian)Debian"
		} elseif ($logo -eq "pop") {
		write-output "$($color.pop)Pop!_OS"
		} elseif ($logo -eq "tux") {
			write-output "$($color.orange)Linux"
		} elseif ($logo -eq "ubuntu") {
			write-output "$($color.orange)Ubuntu"
		} elseif ($logo -eq "mac") {
			write-output "$($color.indigo)MacOS"
		} else {
			if($(Get-CimInstance Win32_OperatingSystem)) {
				render win_fetch
				write-host "$(Get-CimInstance Win32_OperatingSystem)" # fallback
			} else {
				write-output "$($color.violet)Unknown OS" # TempleOS or some shit right here
			}
		}
	}
}
Export-ModuleMember -Variable color
Export-ModuleMember -Variable time
Export-ModuleMember -Variable esc
Export-ModuleMember -Function *

write-host "you are running $($color.win11)clib$($color.reset) $($color.yellow)$($clibManifest.version)$($color.reset) in $($color.win10)compatibility mode.$($color.reset)`n$($color.win11)clib$($color.reset) $($color.win10)compatibility mode$($color.reset) may not have the most recent features.`n$($color.win11)clib$($color.reset) $($color.win10)compatibility mode$($color.reset) only has necessary render assets.`nas of $($color.yellow)1.2.0$($color.reset), it only includes $($color.debian)cfetch$($color.reset) assets`nupgrade to $($color.green)pwsh 7.x$($color.reset) or $($color.win11)windows 11$($color.reset) to be able to run $($color.win11)clib core.$($color.reset)"