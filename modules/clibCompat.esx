#>
	} elseif($type -eq "fetch_unknown_os"){
		write-output "$($color.violet)`n		▄████▄`n		█▀  ▀█`n		    ▄█`n		 ▄███▀`n		 █▀`n`n		 ▀`n$($color.reset)"
	} elseif($type -eq "cerealos"){
		write-output "$($color.pink)cereal_os_easteregg_fetch$($color.reset)"
	} elseif($type -eq "mac") {
		write-output "$($color.cyan)mac_os_cfetch_ascii$($color.reset)"
	} elseif($type -eq "tux") {
		write-output "$($color.orange)linux_cfetch_ascii$($color.reset)"
	} elseif($type -eq "fedora") {
		write-output "$($color.win11)fedora_cfetch_ascii$($color.reset)"
	} elseif($type -eq "artix") {
		write-output "$($color.win11)artix_cfetch_ascii$($color.reset)"
	} elseif($type -eq "android") {
		write-output "$($color.mint)android_cfetch_ascii$($color.reset)"
	} elseif($type -eq "amogos") {
		write-output "$($color.red)amog$($color.reset)$($color.cyan)os$($color.reset)$($color.red)_cfetch_ascii$($color.reset)"
				} else {
		softthrow "no asset of that name found; clibCompat may not have it."
		if(-not $fwd) {
			watermark $type -fwd
		}
	}
}

function clib([switch]$version, [switch]$fork, [switch]$dev, [switch]$vername, [switch]$libname, [switch]$esx) {
	if($libname){
		if($clibManifest.fork -eq $false) {
			watermark clib
		} else {
			write-output $($clibManifest).lib_name
		}
	}
	if($version){
		write-output $($clibManifest).version
	}
	if($vername){
		write-output $($clibManifest).ver_name
	}
	if($dev){
		write-output "by" $($clibManifest).dev_name
	}
	if($fork){
		if($clibManifest.fork -eq $true){
			write-output "is a fork"
		}else{
			write-output "not a fork"
		}
	}
	if($esx){
		if($clibManifest.esx -eq $true){
			write-output "esx build"
		}else{
			write-output "psm1 build"
		}
	}
}

function cdump { # this function is uh.. not very useful.. unless youre just deciding to dump clib colors
$order = @('black','darkgray','gray','lightgray','white','afterthought','debian','lesbian1','red','orange','lesbian2','yellow','butter','mint','green','cyan','pop','win11','azure','win10','cobalt','blue','indigo','violet','lesbian4','pink','lesbian3','cereal','lunar')
$line = ""
$i = 0
foreach ($name in $order) {
    $c = $color[$name]
    if (-not $c) { continue }
    $bg = $c -replace '\[38;', '[48;'
    $line += "$bg  $($color.reset)"
    $i++
    if ($i % 16 -eq 0) {
        $line += "`n"
    }
}
Write-Host $line
}

function Reset-CIMCache {
	if ($IsWindows -or $PSVersionTable.PSEdition -eq "Desktop") {
		$script:osInfo = Get-CimInstance Win32_OperatingSystem
		$script:csystem = get-ciminstance Win32_ComputerSystem
		$script:csysprod = get-ciminstance Win32_ComputerSystemProduct
		$script:cpu = get-ciminstance Win32_Processor
		$script:gpu = get-ciminstance Win32_VideoController
		$script:ram = get-ciminstance Win32_PhysicalMemory
		$script:mobo = get-ciminstance Win32_BaseBoard
		$script:bios = get-ciminstance Win32_BIOS
	}
}
Reset-CIMCache

function Get-OSKey {
	if($IsDiscord) { return "discord" } # wow discord os
    $os = [System.Runtime.InteropServices.RuntimeInformation]::OSDescription
    if ($os -match "Windows") {
        $caption = $script:osInfo.Caption
        if ($caption -match "Windows 11") { return "win11_fetch" }
        elseif ($caption -match "Windows 10") { return "win10_fetch" }
        else { return "win_fetch" }
    }
    elseif ($os -match "Linux") {
        if (-not (Test-Path /etc/os-release)) {
            return "tux"
        }
        $osInfo = Get-Content /etc/os-release | ConvertFrom-StringData
        $id = $osInfo.ID.ToLower()
        switch ($id) {
			"fedora"    {return "fedora"}
            "arch"        { return "arch" } # btw
			"nyarch"    { return "nyarch" } # ntw
			"artix"      { return "artix" } # btw
            "linuxmint" { return "mint" }
            "debian"    { return "debian" }
            "lesbian"    { return "lesbian" }
            "cerealos"    { return "cerealos" } # **my** operating system??
            "ubuntu"    { return "ubuntu" }
			"uwuntu"    { return "uwuntu" }
            "pop"       { return "pop" }
			"android" { return "android" }
			"amogos" { return "amogos" }
			"alpine" { return "alpine" }
			"opensuse-leap" { return "opensuse" }
			"opensuse-tumbleweed" { return "opensuse_butter" }
			"gentoo" { return "gentoo" }
			"neon" { return "kde_neon" }
			"zorin" {return "zorin"}
			"elementary" {return "elementary"}
            default      { return "tux" }
        }
    }
    elseif ($os -match "Darwin") {
        return "mac"
    }
    return "fetch_unknown_os"
}
function lesbian{
	if ((random 1 100) -eq 1) {
		return "lesbian"
	} else {
		return "debian"
	}
}

function resolveOSC($OSin) {
	if($OSin -eq "arch" -or $OSin -eq "win11_fetch" -or $OSin -eq "windows_11" -or $OSin -eq "artix" -or $OSin -eq "fedora" -or $OSin -eq "alpine" -or $OSin -eq "nyarch" -or $OSin -eq "zorin") {
		return $($color.win11)
	} elseif ($OSin -eq "win10_fetch" -or $OSin -eq "win_fetch" -or $OSin -eq "windows" -or $OSin -eq "windows_10" -or $OSin -eq "discord") {
		return $($color.win10)
	} elseif ($OSin -eq "mint" -or $OSin -eq "android" -or $OSin -eq "opensuse" -or $OSin -eq "opensuse_leap" -or $OSin -eq "kde_neon" -or $OSin -eq "neon" -or $OSin -eq "linux_mint") {
		return $($color.mint)
	} elseif ($OSin -eq "pop") {
		return $($color.pop)
	} elseif ($OSin -eq "tux" -or $OSin -eq "ubuntu" -or $OSin -eq "linux") {
		return $($color.orange)
	} elseif ($OSin -eq "debian") {
		return $($color.debian)
	} elseif ($OSin -eq "mac") {
		return ($($color.cyan)) 
	} elseif ($OSin -eq "cerealos") {
		return ($($color.pink))
	} elseif ($OSin -eq "amogos") {
		return ($($color.red))
	} elseif ($OSin -eq "gentoo") {
		return ($($color.lunar))
	} elseif ($OSin -eq "opensuse_butter" -or $OSin -eq "opensuse_tumbleweed") {
		return ($($color.butter))
	} elseif ($OSin -eq "lesbian") {
		return $($color.lesbian4)
	} elseif ($OSin -eq "elementary") {
		return ""
	} elseif ($OSin -eq "uwuntu") {
		return $($color.cereal)
	} else {
		return ($($color.violet))
	}
}

