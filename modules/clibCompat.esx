function htaTool {
    param(
        [Parameter(Mandatory)]
        [string]$Hex
    )

    $Hex = $Hex.TrimStart("#")

    if ($Hex.Length -ne 6) {
        throw "Invalid hex color: $Hex (expected #RRGGBB)"
    }

    $r = [Convert]::ToInt32($Hex.Substring(0,2),16)
    $g = [Convert]::ToInt32($Hex.Substring(2,2),16)
    $b = [Convert]::ToInt32($Hex.Substring(4,2),16)

	if (-not ($host.Name -eq "Windows PowerShell ISE Host" -or $psise)) {
		write-output "${esc}[38;2;$r;$g;${b}m`${esc}[38;2;$r;$g;${b}m"
	} else {
		write-output "`${esc}[38;2;$r;$g;${b}m"
	}
}

function htaToolPure {
    param(
        [Parameter(Mandatory)]
        [string]$Hex
    )

    $Hex = $Hex.TrimStart("#")

    if ($Hex.Length -ne 6) {
        throw "Invalid hex color: $Hex (expected #RRGGBB)"
    }

    $r = [Convert]::ToInt32($Hex.Substring(0,2),16)
    $g = [Convert]::ToInt32($Hex.Substring(2,2),16)
    $b = [Convert]::ToInt32($Hex.Substring(4,2),16)
	if (-not ($host.Name -eq "Windows PowerShell ISE Host" -or $psise)) {
		return "${esc}[38;2;$r;$g;${b}m"
	}
}


function render($type, [switch]$fwd) {
	 if ($type -eq "efas") {
		write-output "$($color.efas)efas_ascii$($color.reset)"
	} elseif ($type -eq "windows") {
		write-output "$($color.blue)win_generic_ascii$($color.reset)"
	}elseif($type -eq "windows_11") {
		write-output "$($color.win11)win11_ascii$($color.reset)"
	}elseif($type -eq "windows_10") {
		write-output "$($color.win10)win10_ascii$($color.reset)"
	}elseif($type -eq "win11_fetch") {
		write-output "$($color.win11)`n	██████ ██████`n	██████ ██████`n	██████ ██████`n	▄▄▄▄▄▄ ▄▄▄▄▄▄`n	██████ ██████`n	██████ ██████`n	▀▀▀▀▀▀ ▀▀▀▀▀▀`n$($color.reset)" # handmade by cereal <3 (FUCK windows 11)
	}elseif($type -eq "arch") {
		write-output "$($color.win11)btw_cfetch_ascii$($color.reset)"
	}elseif($type -eq "mint" -or $type -eq "linux mint") {
		write-output "$($color.mint)linux_mint_cfetch_ascii$($color.reset)"
	}elseif($type -eq "ubuntu") {
		write-output "$($color.orange)ubuntu_cfetch_ascii$($color.reset)"
	}elseif($type -eq "pop!_os" -or $type -eq "pop") {
		write-output "$($color.pop)pop!_os_cfetch_ascii$($color.reset)"
