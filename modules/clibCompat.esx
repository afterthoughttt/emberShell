function Invoke-CfetchPanic {
    param([string]$Message = "A fatal error has occurred.")
    
    $e = [char]27
    [Console]::BackgroundColor = "DarkBlue"
    [Console]::ForegroundColor = "White"
    [Console]::Clear()
    
    Write-Host ""
    Write-Host ""
    Write-Host "  cfetch encountered a fatal error:"
    Write-Host ""
    Write-Host "  $Message"
    Write-Host ""
    Read-Host "  Press Enter to exit"
    
    [Console]::ResetColor()
    [Console]::Clear()
}
function cfetch($larp, [switch]$precise, [switch]$bloat, [switch]$clean, [switch]$extra, [switch]$locale) { # now thats a LOT of flags.. i know....
if ($IsWindows -or $PSVersionTable.PSEdition -eq "Desktop") {
	$script:osInfo = Get-CimInstance Win32_OperatingSystem
	$swap = Get-CimInstance Win32_PageFileUsage
	$battery = get-ciminstance Win32_Battery
	$batteryValueFallback = Get-CimInstance -Namespace ROOT\WMI BatteryStatus
}
	if ($clean) {
		clear
	}
	if ($IsWindows -or $PSVersionTable.PSEdition -eq 'Desktop') {
		$dwm = (Get-Item "$env:SystemRoot\System32\dwm.exe").VersionInfo.ProductVersion
		$wm = "Desktop Window Manager"
		$wm_version = $dwm
		$de = ""
		$de_version = ""
		$theme = ""

		$systemLight = Get-ItemPropertyValue -Path "HKCU:\Software\Microsoft\Windows\CurrentVersion\Themes\Personalize" -Name "SystemUsesLightTheme" -ErrorAction SilentlyContinue
		$wm_theme = if ($systemLight -eq 1) { "Light" } else { "Dark" }

		$accentRaw = Get-ItemPropertyValue -Path "HKCU:\Software\Microsoft\Windows\CurrentVersion\Explorer\Accent" -Name "AccentColorMenu" -ErrorAction SilentlyContinue
		if ($accentRaw) {
			$a = [System.BitConverter]::GetBytes([uint32]$accentRaw)
			$accent_color = "#{0:X2}{1:X2}{2:X2}" -f $a[0], $a[1], $a[2]
		} else {
			$accent_color = ""
		}
	} else {
		$de = ""
		$wm = ""
		$wm_version = ""
		$de_version = ""
		$theme = ""
		$accent_color = ""

		if ($env:XDG_CURRENT_DESKTOP) {
			$de = $env:XDG_CURRENT_DESKTOP
		} elseif ($env:DESKTOP_SESSION) {
			$de = $env:DESKTOP_SESSION
		} elseif ($env:XDG_SESSION_DESKTOP) {
			$de = $env:XDG_SESSION_DESKTOP
		}

		if (-not $de) {
			$uid = (& id -u 2>$null)
			$userRun = "/run/user/$uid"
			if (Test-Path "$userRun/KSMserver*" -ErrorAction SilentlyContinue) { $de = "KDE" } # y u have to be this way KDE?
			elseif (Test-Path "$userRun/gnome-session*" -ErrorAction SilentlyContinue) { $de = "GNOME" }
			elseif (Test-Path "$userRun/xfce*" -ErrorAction SilentlyContinue) { $de = "XFCE" }
			elseif (Test-Path "$userRun/mate*" -ErrorAction SilentlyContinue) { $de = "MATE" }
		}

		if (-not $de) {
			$procs = (& ps aux 2>$null)
			if ($procs | Select-String "plasmashell") { $de = "KDE" }
			elseif ($procs | Select-String "gnome-shell") { $de = "GNOME" }
			elseif ($procs | Select-String "xfce4-session") { $de = "XFCE" }
			elseif ($procs | Select-String "mate-session") { $de = "MATE" }
			elseif ($procs | Select-String "cinnamon") { $de = "Cinnamon" }
			elseif ($procs | Select-String "budgie-daemon") { $de = "Budgie" }
		}

		if (-not $de) {
			$session2 = (& loginctl list-sessions --no-legend 2>$null) | Where-Object { $_ -match (& whoami) } | Select-Object -First 1 | ForEach-Object { ($_ -split "\s+")[0] }
			if ($session2) {
				$xdg = (& loginctl show-session $session2 -p Desktop --value 2>$null).Trim()
				if ($xdg) { $de = $xdg }
			}
		}

		if ($env:HYPRLAND_INSTANCE_SIGNATURE) {
			$wm = "Hyprland"
		} elseif ($env:SWAYSOCK) {
			$wm = "Sway"
		} elseif ($de) {
			$wm = switch ($de) {
				"KDE"        { "KWin" }
				"GNOME"      { "Mutter" }
				"XFCE"       { "Xfwm4" }
				"MATE"       { "Marco" }
				"Cinnamon"   { "Muffin" }
				"Budgie"     { "Budgie WM" }
				"LXQt"       { "Openbox" }
				"LXDE"       { "Openbox" }
				default      { "" }
			}
		}

		# session type
		$uid = (& id -u 2>$null)
		$userRun = "/run/user/$uid"
		$session_type = if ($env:WAYLAND_DISPLAY) { "Wayland" }
			elseif (Test-Path "$userRun/wayland-0") { "Wayland" }
			elseif ($env:DISPLAY) { "X11" }
			else { "" }
		$wm_theme = if ($session_type) { "$wm ($session_type)" } else { "" }

		# DE version
		if ($de) {
			$de_version = switch ($de) {
				"KDE"      { (& plasmashell --version 2>$null) -replace "plasmashell ", "" }
				"GNOME"    { (& gnome-shell --version 2>$null) -replace "GNOME Shell ", "" }
				"XFCE"     { (& xfce4-session --version 2>$null | Select-Object -First 1) -replace "xfce4-session ", "" }
				"Cinnamon" { (& cinnamon --version 2>$null) -replace "Cinnamon ", "" }
				"MATE"     { (& mate-session --version 2>$null | Select-Object -First 1) -replace "mate-session ", "" }
				default    { "" }
			}
		}

		# theme
		if ($env:GTK_THEME) {
			$theme = $env:GTK_THEME
		} elseif ($de -eq "KDE") {
			$theme = (& kreadconfig5 --group "General" --key "Name" --file kdeglobals 2>$null)
			if (-not $theme) { $theme = (& kreadconfig6 --group "General" --key "Name" --file kdeglobals 2>$null) }
		} elseif ($de -eq "GNOME" -or $de -eq "Cinnamon" -or $de -eq "MATE") {
			$theme = (& gsettings get org.gnome.desktop.interface gtk-theme 2>$null) -replace "'", ""
		}
	}
	if ($env:WT_SESSION) {
		$term = "Windows Terminal"
		$term_version = (Get-AppxPackage -Name Microsoft.WindowsTerminal -ErrorAction SilentlyContinue).Version
		if (-not $term_version) { $term_version = "" }
	} elseif ($env:TERM_PROGRAM) {
		switch ($env:TERM_PROGRAM) {
			"mintty"     { $term = "MinTTY" }
			"iTerm.app"  { $term = "iTerm2" }
			"WezTerm"    { $term = "WezTerm" }
			"vscode"     { $term = "VS Code" }
			"Hyper"      { $term = "Hyper" }
			"tabby"      { $term = "Tabby" }
			default      { $term = $env:TERM_PROGRAM }
		}
		$term_version = $env:TERM_PROGRAM_VERSION
		if (-not $term_version) { $term_version = "" }
	} elseif ($env:KITTY_WINDOW_ID) {
		$term = "Kitty"
		$term_version = ""
	} elseif ($env:KONSOLE_VERSION) {
		$term = "Konsole"
		$term_version = $env:KONSOLE_VERSION
	} elseif ($env:ALACRITTY_SOCKET -or $env:ALACRITTY_LOG) {
		$term = "Alacritty"
		$term_version = ""
	} elseif ($env:GNOME_TERMINAL_SERVICE) {
		$term = "GNOME Terminal"
		$term_version = ""
	} elseif ($env:TERM) {
		switch ($env:TERM) {
			"alacritty"      { $term = "Alacritty" }
			"kitty"          { $term = "Kitty" }
			"xterm-kitty"    { $term = "Kitty" }
			"rxvt-unicode"   { $term = "URxvt" }
			default          { $term = $env:TERM }
		}
		$term_version = ""
	} elseif ($host.Name -eq "Windows PowerShell ISE Host" -or $psise) {
		$term = "Windows PowerShell ISE"
		$term_version = ""
	} elseif ($IsWindows -or $PSVersionTable.PSEdition -eq 'Desktop') {
		$term = "conhost"
		$term_version = ""
	} else {
		$term = "Unknown"
		$term_version = ""
	}
	$cursor = $null
	if ($env:XCURSOR_THEME) {
		$cursor = $env:XCURSOR_THEME
	} elseif ($de -eq "KDE") {
		$cursor = (& kreadconfig5 --group "Icons" --key "Cursor" --file kdeglobals 2>$null)
		if (-not $cursor) { $cursor = (& kreadconfig6 --group "Icons" --key "Cursor" --file kdeglobals 2>$null) }
	} elseif ($de -eq "GNOME" -or $de -eq "Cinnamon" -or $de -eq "MATE") {
		$cursor = (& gsettings get org.gnome.desktop.interface cursor-theme 2>$null) -replace "'", ""
	}
	if (-not $cursor) {
		if (Test-Path "$HOME/.config/gtk-3.0/settings.ini") {
			$cursor = (Get-Content "$HOME/.config/gtk-3.0/settings.ini" | Select-String "gtk-cursor-theme-name") -replace "gtk-cursor-theme-name\s*=\s*", ""
		}
	}

	$sys_font = $null
if ($IsWindows -or $PSVersionTable.PSEdition -eq 'Desktop') {
    $raw = (Get-ItemPropertyValue -Path "HKCU:\Control Panel\Desktop\WindowMetrics" -Name "IconFont" -ErrorAction SilentlyContinue)
    if ($raw) {
        $sys_font = ($raw[20..60] | ForEach-Object { [char]$_ } | Where-Object { $_ -ne [char]0 }) -join ""
    }
    if (-not $sys_font) {
        $sys_font = if (([System.Environment]::OSVersion.Version).Major -ge 10) { "Segoe UI" } else { "Tahoma" }
    }
} else {
    if ($de -eq "GNOME" -or $de -eq "Cinnamon" -or $de -eq "MATE") {
        $sys_font = (& gsettings get org.gnome.desktop.interface font-name 2>$null) -replace "'", ""
    } elseif ($de -eq "KDE") {
        $sys_font = (& kreadconfig5 --group "General" --key "font" --file kdeglobals 2>$null)
        if (-not $sys_font) { $sys_font = (& kreadconfig6 --group "General" --key "font" --file kdeglobals 2>$null) }
    }
    if (-not $sys_font) {
        if (Test-Path "$HOME/.config/gtk-3.0/settings.ini") {
            $sys_font = (Get-Content "$HOME/.config/gtk-3.0/settings.ini" | Select-String "gtk-font-name") -replace "gtk-font-name\s*=\s*", ""
        }
    }
}
	$term_font = $null
	if ($term -eq "Windows Terminal") {
		$wtSettingsPath = $env:WT_SETTINGS_PATH
		if (-not $wtSettingsPath) {
			$wtSettingsPath = (Get-Item "$env:LOCALAPPDATA\Packages\Microsoft.WindowsTerminal_*\LocalState\settings.json" -ErrorAction SilentlyContinue).FullName
		}
		if ($wtSettingsPath -and (Test-Path $wtSettingsPath)) {
			try {
				$wtSettings = Get-Content $wtSettingsPath -Raw | ConvertFrom-Json
				$profile = $wtSettings.profiles.list | Where-Object { $_.guid -eq $env:WT_PROFILE_ID } | Select-Object -First 1
				if (-not $profile) { $profile = $wtSettings.profiles.defaults }
				$term_font = $profile.font.face
			} catch { $term_font = $null }
		}
		if (-not $term_font) { $term_font = "Cascadia Mono" }
	} elseif ($term -eq "Kitty" -and (Test-Path "$HOME/.config/kitty/kitty.conf")) {
		$term_font = (Get-Content "$HOME/.config/kitty/kitty.conf" | Select-String "^font_family") -replace "font_family\s+", ""
	} elseif ($term -eq "Alacritty") {
		$alacrittyToml = "$HOME/.config/alacritty/alacritty.toml"
		$alacrittyYml  = "$HOME/.config/alacritty/alacritty.yml"
		if (Test-Path $alacrittyToml) {
			$term_font = (Get-Content $alacrittyToml | Select-String "^\s*family\s*=") -replace '.*=\s*"?([^"]+)"?.*', '$1'
		} elseif (Test-Path $alacrittyYml) {
			$term_font = (Get-Content $alacrittyYml | Select-String "^\s*family:") -replace '.*family:\s*', ''
		}
	} elseif ($term -eq "Konsole") {
		$konsoleProfile = Get-ChildItem "$HOME/.local/share/konsole/*.profile" -ErrorAction SilentlyContinue | Select-Object -First 1
		if ($konsoleProfile) {
			$term_font = (Get-Content $konsoleProfile | Select-String "^Font=") -replace "Font=", "" -replace ",.*", ""
		}
	} elseif ($term -eq "conhost") {
		$kern = [System.Environment]::OSVersion.Version
		$term_font = if ($kern.Major -ge 10) { "Consolas" } else { "Lucida Console" }
	} elseif ($term -eq "Windows PowerShell ISE") {
		$term_font = $psise.options.fontname
	}
	if (-not $term_font -and $term -eq "Windows Terminal") {
		$term_font = "Cascadia Mono"
	}
	<#if ($bloat) {
		if ($term -eq "Windows Terminal") {
			$wtSettingsPath = $env:WT_SETTINGS_PATH
			if (-not $wtSettingsPath) {
				$wtSettingsPath = (Get-Item "$env:LOCALAPPDATA\Packages\Microsoft.WindowsTerminal_*\LocalState\settings.json" -ErrorAction SilentlyContinue).FullName
			}
			if ($wtSettingsPath -and (Test-Path $wtSettingsPath)) {
				try {
					$wtSettings = Get-Content $wtSettingsPath -Raw | ConvertFrom-Json
					$profile = $wtSettings.profiles.list | Where-Object { $_.guid -eq $env:WT_PROFILE_ID } | Select-Object -First 1
					if (-not $profile) { $profile = $wtSettings.profiles.defaults }
					$bloat_wtpname = $profile.name
					$bloat_wtpscheme = $profile.colorScheme
					$shaderPath   = $profile.psobject.Properties["experimental.pixelShaderPath"]?.Value
					$retroEffect  = $profile.psobject.Properties["experimental.retroTerminalEffect"]?.Value

					if ($shaderPath) {
						$bloat_shader = ([System.IO.Path]::GetFileNameWithoutExtension($shaderPath)).Replace('_', ' ')
					} elseif ($retroEffect) {
						$bloat_shader = "Retro Terminal"
					}
					if ($null -ne $profile.opacity) {
						$bloat_opacity = $profile.opacity
					}
				} catch {
					$idk = "what am i even doing"
				}
			} 
		}
	}#> # why did i make this?
		# preserved for the forks to use ig
	if ($larp) {
		$resolvedosc = resolveOSC($larp)
		if ($larp -notin $validOSes) {
			render "fetch_unknown_os"
		} else {
			render $larp
		}
		if ($larp -eq "win_fetch" -or $larp -eq "windows") {
			write-output "$($resolvedosc)OS:            Windows"
		} elseif ($larp -eq "win10_fetch" -or $larp -eq "windows_10") {
			write-output "$($resolvedosc)OS:            Windows 10"
		} elseif ($larp -eq "win11_fetch" -or $larp -eq "windows_11") {
			write-output "$($resolvedosc)OS:            Windows 11"
		} elseif ($larp -eq "arch") {
			write-output "$($resolvedosc)OS:            Arch" # btw
		} elseif ($larp -eq "mint" -or $larp -eq "linux_mint") {
			write-output "$($resolvedosc)OS:            Linux Mint"
		} elseif ($larp -eq "debian") {
			write-output "$($resolvedosc)OS:            Debian"
		} elseif ($larp -eq "pop") {
			write-output "$($resolvedosc)OS:            Pop!_OS"
		} elseif ($larp -eq "tux" -or $larp -eq "linux") {
			write-output "$($resolvedosc)OS:            Linux"
		} elseif ($larp -eq "ubuntu") {
			write-output "$($resolvedosc)OS:            Ubuntu"
		} elseif ($larp -eq "mac") {
			write-output "$($resolvedosc)OS:            MacOS"
		} elseif ($larp -eq "cerealos") {
			write-output "$($resolvedosc)OS:            CerealOS"
		} elseif ($larp -eq "artix") {
			write-output "$($resolvedosc)OS:            Artix"
		} elseif ($larp -eq "fedora") {
			write-output "$($resolvedosc)OS:            Fedora"
		} elseif ($larp -eq "android") {
			write-output "$($resolvedosc)OS:            Android"
		} elseif ($larp -eq "amogos") {
			write-output "$($resolvedosc)OS:            AmogOS"
		} elseif ($larp -eq "alpine") {
			write-output "$($resolvedosc)OS:            Alpine"
		} elseif ($larp -eq "nyarch") {
			write-output "$($resolvedosc)OS:            Nyarch"
		} elseif ($larp -eq "gentoo") {
			write-output "$($resolvedosc)OS:            Gentoo"
		} elseif ($larp -eq "opensuse" -or $larp -eq "opensuse_leap") {
			write-output "$($resolvedosc)OS:            openSUSE"
		} elseif ($larp -eq "opensuse_butter" -or $larp -eq "opensuse_tumbleweed") {
			write-output "$($resolvedosc)OS:            openSUSE"
		} elseif ($larp -eq "lesbian") {
			write-output "$($resolvedosc)OS:            Lesbian"
		} elseif ($larp -eq "kde_neon" -or $larp -eq "neon") {
			write-output "$($resolvedosc)OS:            KDE Neon"
		} elseif ($larp -eq "elementary") {
			write-output "$($resolvedosc)OS:            ElementaryOS"
		} elseif ($larp -eq "zorin") {
			write-output "$($resolvedosc)OS:            Zorin OS"
		} elseif ($larp -eq "uwuntu") {
			write-output "$($resolvedosc)OS:            UwUntu"
		} elseif ($larp -eq "discord") {
			write-output "$($resolvedosc)OS:            Discord"
		} else { 
			write-output "$($resolvedosc)OS:            $larp"
		}
	} else {
		$logo = Get-OSKey
		if($logo -eq "debian") {
			$logo = lesbian
		}
		$resolvedosc = resolveOSC($logo)
		if ($logo -notin $validOSes) {
			render "fetch_unknown_os"
		} else {
			render $logo
		}
		$winedition = $script:osInfo.Caption -replace "Microsoft Windows \d+ ", ""
		$winversion = $script:osInfo.Caption -replace "Microsoft Windows ", ""
		if ($logo -eq "win_fetch") {
			write-output "$($resolvedosc)OS:            Windows $winversion"
		} elseif ($logo -eq "win10_fetch") {
			write-output "$($resolvedosc)OS:            Windows 10 $winedition"
		} elseif ($logo -eq "win11_fetch") {
			write-output "$($resolvedosc)OS:            Windows 11 $winedition"
		} elseif ($logo -eq "arch") {
			write-output "$($resolvedosc)OS:            Arch" # btw
		} elseif ($logo -eq "mint") {
			write-output "$($resolvedosc)OS:            Linux Mint"
		} elseif ($logo -eq "debian") {
			write-output "$($resolvedosc)OS:            Debian"
		} elseif ($logo -eq "pop") {
			write-output "$($resolvedosc)OS:            Pop!_OS"
		} elseif ($logo -eq "tux") {
			write-output "$($resolvedosc)OS:            Linux"
		} elseif ($logo -eq "ubuntu") {
			write-output "$($resolvedosc)OS:            Ubuntu"
		} elseif ($logo -eq "mac") {
			write-output "$($resolvedosc)OS:            MacOS"
		} elseif ($logo -eq "artix") {
			write-output "$($resolvedosc)OS:            Artix"
		} elseif ($logo -eq "fedora") {
			write-output "$($resolvedosc)OS:            Fedora"
		} elseif ($logo -eq "android") {
			write-output "$($resolvedosc)OS:            Android"
		} elseif ($logo -eq "amogos") {
			write-output "$($resolvedosc)OS:            AmogOS"
		} elseif ($logo -eq "alpine") {
			write-output "$($resolvedosc)OS:            Alpine"
		} elseif ($logo -eq "nyarch") {
			write-output "$($resolvedosc)OS:            Nyarch"
		} elseif ($logo -eq "gentoo") {
			write-output "$($resolvedosc)OS:            Gentoo"
		} elseif ($logo -eq "opensuse") {
			write-output "$($resolvedosc)OS:            openSUSE"
		} elseif ($logo -eq "opensuse_butter") {
			write-output "$($resolvedosc)OS:            openSUSE"
		} elseif ($logo -eq "lesbian") {
			write-output "$($resolvedosc)OS:            Lesbian"
		} elseif ($logo -eq "cerealos") {
			write-output "$($resolvedosc)OS:            CerealOS"
		} elseif ($logo -eq "kde_neon" -or $logo -eq "neon") {
			write-output "$($resolvedosc)OS:            KDE Neon"
		} elseif ($logo -eq "elementary") {
			write-output "$($resolvedosc)OS:            ElementaryOS"
		} elseif ($logo -eq "zorin") {
			write-output "$($resolvedosc)OS:            Zorin OS"
		} elseif ($logo -eq "uwuntu") {
			write-output "$($resolvedosc)OS:            UwUntu"
		} elseif ($logo -eq "discord") {
			write-output "$($resolvedosc)OS:            Discord"
		} else {
			if ($IsWindows -or ($PSVersionTable.PSEdition -eq "Desktop")) {
				render win_fetch
				$winfallback = $script:osInfo.Caption -replace "Microsoft ", ""
				write-host "$($resolvedosc)OS:            $winfallback"
			} elseif ($IsMac) {
				render mac
				resolveOSC("mac")
				write-output "$($resolvedosc)OS:            MacOS"
			} elseif ($IsLinux) {
				render tux
				resolveOSC("tux")
				write-output "$($resolvedosc)OS:            Linux"
			} else {
				write-output "$($resolvedosc)OS:            Unknown" # ...? TempleOS is that you??
			}
		}
	}
	if ($IsWindows -or ($PSVersionTable.PSEdition -eq "Desktop")) {
		if ($bloat) {
			Write-output "$($resolvedosc)OS Class:      NT" # ... it says this in the kernel name ... why do you need to know?
		}
		$kern = [System.Environment]::OSVersion.Version
		if ($precise) {
			if ($PSVersionTable.Platform) {
				$kerntype = $($PSVersionTable.Platform)
			} else {
				$kerntype = "Win32NT"
			}
		} else {
			if ($($PSVersionTable.Platform) -eq "Win32NT") {
				$kerntype = "Windows NT"
			} else {
				if ($PSVersionTable.Platform) {
					$kerntype = $($PSVersionTable.Platform)
				} else {
					$kerntype = "Windows NT"
				}
			}
		}
		if (-not ($kern.Revision -ge 1)) {
			Write-output "$($resolvedosc)Kernel:        $kerntype $($kern.Major).$($kern.Minor).$($kern.Build)"
		} else {
			write-output "$($resolvedosc)Kernel:        $kerntype $($kern.Major).$($kern.Minor).$($kern.Build).$($kern.Revision)"
		}
		if($extra) {
			if (get-command hostname -erroraction silentlycontinue) {
				$hostid = hostname
			} elseif ($env:USERDOMAIN) {
				$hostid = $env:USERDOMAIN
			} elseif ($script:osInfo) {
				$hostid = $script:osInfo.CSName # we already have this cached from win 11 caption
			} elseif (whoami --erroraction silentlycontinue) {
				$hostid = $((whoami).Split('\')[0]) # boring whoami fallback, slowest option
			} else {
				if ($script:csystem) {
					$hostid = $script:csystem.Name
				}
			}
			if ($env:USERNAME) {
				$user = $env:USERNAME
			} else {
				$user = $((whoami).Split('\')[1]) # no huge fallback path.. strange..
			}
			write-output "$($resolvedosc)User:          $user@$hostid"
		}
		if ($ESVersionTable -and $Precise) {
			write-output "$($resolvedosc)Shell:         emberShell $($ESVersionTable.ESEdition) $($ESVersionTable.ESVersion) `($($PSVersionTable.PSEdition) $($PSVersionTable.PSVersion)`)"
		} elseif ($ESVersionTable) { # hey cool! someone using clib the intended way
			write-output "$($resolvedosc)Shell:         emberShell $($ESVersionTable.ESEdition) $($ESVersionTable.ESVersion)"
		} elseif ($Precise) {
			write-output "$($resolvedosc)Shell:         PowerShell $($PSVersionTable.PSEdition) $($PSVersionTable.PSVersion)"
		} else {
			write-output "$($resolvedosc)Shell:         PowerShell $($PSVersionTable.PSEdition) $("$($PSVersionTable.PSVersion)".Substring(0,5))"
		}
		if ($precise) {
			write-output "$($resolvedosc)Terminal:      $term $term_version"
		} else {
			write-output "$($resolvedosc)Terminal:      $term"
		}
		write-output "$($resolvedosc)Terminal Font: $term_font"
		<#if ($bloat) {
			if ($bloat_wtpname) {
				write-output "$($resolvedosc)Profile:       $bloat_wtpname"
			}
			if ($bloat_wtpscheme) {
				write-output "$($resolvedosc)Color Scheme:  $bloat_wtpscheme"
			}
			if ($bloat_shader) {
				write-output "$($resolvedosc)Shader:        $bloat_shader"
			}
			if ($bloat_opacity) {
				write-output "$($resolvedosc)Opacity:       $bloat_opacity"
			}
		} #>
		if ($precise) {
			Write-Output "$($resolvedosc)WM:            $wm $wm_version"
		} else {
			Write-Output "$($resolvedosc)WM:            $wm"
		}
		Write-Output "$($resolvedosc)WM Theme:      $wm_theme"
		Write-Output "$($resolvedosc)Accent Color:  $(htaToolPure $accent_color)$accent_color$($color.reset)"
		Write-Output "$($resolvedosc)System Font:   $sys_font"
		if($cursor) {
			Write-Output "$($resolvedosc)Cursor:        $cursor"
		}
		Write-Output "$($resolvedosc)CPU:           $($script:cpu.Name)"
		Write-Output "$($resolvedosc)CPU Base:      $($script:cpu.MaxClockSpeed)MHz"
		Write-Output "$($resolvedosc)CPU Cores:     $($script:cpu.NumberOfCores)"
		Write-Output "$($resolvedosc)CPU Threads:   $($script:cpu.NumberOfLogicalProcessors)"
		if ($bloat) {
			$architecture = $env:PROCESSOR_ARCHITECTURE
			$bits = switch ($arch) {
				"x86"    { "32-bit" }
				"ARM"    { "32-bit" }
				"armv7l" { "32-bit" }
				"i386"   { "32-bit" }
				"i486"   { "32-bit" }
				"i586"   { "32-bit" }
				"i686"   { "32-bit" }
				default  { "64-bit" }
			}
			Write-Output "$($resolvedosc)Architecture:  $architecture ($bits)"
		}
		$total = ($script:ram | Measure-Object -Property Capacity -Sum).Sum / 1GB
		if($script:gpu.AdapterDACType -eq "Internal") {
			if ($precise) {
				$usable = $script:osInfo.TotalVisibleMemorySize / 1MB
				$reserved = [math]::Round(($total - $usable) * 1024, 0)
				if ($reserved -gt 1024) {
					$reservedgb = [math]::Round($reserved / 1024, 0)
					$usageigpu = "($reservedgb`GB)"
				} else {
					$usageigpu = "($reserved`MB)"
				}
			} else {$usageigpu = ""}
			$type = "[Integrated] $usageigpu"
		} else {
			$type = ""
		}
		Write-Output "$($resolvedosc)GPU:           $($script:gpu.Name) $type"
		$speed = $script:ram[0].Speed
		$gen = switch ($script:ram[0].SMBIOSMemoryType) {
			18 { "DDR" }
			19 { "DDR2" }
			20 { "DDR2 FB-DIMM" }
			24 { "DDR3" }
			25 { "FBD2" }
			26 { "DDR4" }
			27 { "LPDDR" }
			28 { "LPDDR2" }
			29 { "LPDDR3" }
			30 { "LPDDR4" }
			31 { "LPDDR4X" }
			32 { "DDR5" }
			33 { "LPDDR5" }
			34 { "DDR5" }
			35 { "LPDDR5X" }
			default { "DDR?" }
		}
		if ($gen -eq "DDR?") {
			$gen = switch ($script:ram[0].MemoryType) {
				2 {"DRAM"}
				3 {"Synchronous DRAM"}
				4 {"Cache DRAM"}
				5 {"EDO"}
				6 {"EDRAM"}
				7 {"VRAM"}
				8 {"SRAM"}
				9 {"RAM"}
				10 {"ROM"}
				11 {"Flash"}
				12 {"EEPROM"}
				13 {"FEPROM"}
				14 {"EPROM"}
				15 {"CDRAM"}
				16 {"3DRAM"}
				17 {"SDRAM"}
				18 {"SGRAM"}
				19 {"RDRAM"}
				20 {"DDR"}
				21 {"DDR2"}
				22 {"DDR2 FB-DIMM"}
				23 {"FB-DIMM"}
				24 {"DDR3"}
				25 {"FBD2"}
				26 {"DDR4"}
				default {"RAM"} # how the HELL..? failing when even VRAM as system ram is detected..???
			}
		}
		$soldered = @(27,28,29,30,31,33,35) # guys can we stop doing this stuff.. please..
		if ($script:ram[0].SMBIOSMemoryType -in $soldered) {
			$ff = "Soldered"
		} else {
			$ff = switch($script:ram[0].FormFactor) {
				2 {"SIP"}
				3 {"DIP"}
				4 {"ZIP"}
				5 {"SOJ"}
				6 {"Proprietary Card"}
				7 {"SIMM"}
				8 {"DIMM"}
				9 {"TSOP"}
				10 {"PGA"}
				11 {"RIMM"}
				12 {"SO-DIMM"}
				13 {"SRIMM"}
				14 {"SMD"}
				15 {"SSMP"}
				16 {"QFP"}
				17 {"TQFP"}
				18 {"SOIC"}
				19 {"LCC"}
				20 {"PLCC"}
				21 {"BGA"}
				22 {"FBGA"}
				23 {"LGA"}
				24 {"FB-DIMM"} # this is likely to display weird, maybe change this? >> #1893
				25 {"Die"}
				26 {"CAMM"}
				default {$null}
			}
		}
		if (-not $ff) {
			$ffadd = ""
			if ($script:ram[0].Replaceable -eq $true -or $script:ram[0].Removable -eq $true) {
				$ffadd += "Replaceable "
			}
			if ($script:ram[0].HotSwappable) {
				$ffadd += "Hot Swappable " # wtf?
			}
			$ff = $ffadd.Trim()
		}
		if ($ff -eq "FB-DIMM" -and $gen -eq ("DDR2 FB-DIMM" -or "FB-DIMM")) {
			$ff = "" # fixed :3 >> #1876
		}
		$usedRam = [math]::Round(($script:osInfo.TotalVisibleMemorySize - $script:osInfo.FreePhysicalMemory) / 1MB, 1)
		$totalRam = [math]::Round($script:osInfo.TotalVisibleMemorySize / 1MB, 1)
		$rampercent = [math]::Round(($usedRam/$totalRam)*100, 0)
		if($rampercent -ge 75) {$col = $($color.red)} elseif ($rampercent -ge 50){$col = $($color.yellow)} else {$col = $($color.green)}
	    $MMF = $script:ram[0].Manufacturer
		if ($precise) {
			if ($bloat) {
				Write-Output "$($resolvedosc)RAM:           $($MMF) $($total)GB $($ff) $($gen) $($speed)MT/s"
			} else {
				Write-Output "$($resolvedosc)RAM:           $($total)GB $($ff) $($gen) $($speed)MT/s"
			}
		} elseif ($bloat) {
			Write-Output "$($resolvedosc)RAM:           $($MMF) $($total)GB $($gen) $($speed)MT/s"
		} else {
			Write-Output "$($resolvedosc)RAM:           $($total)GB $($gen) $($speed)MT/s"
		}
		write-output "$($resolvedosc)RAM Usage:     $usedram`GB/$totalram`GB ($col$rampercent`%$($resolvedosc))"
		$swapTotal = [math]::Round(($swap | Measure-Object -Property AllocatedBaseSize -Sum).Sum / 1024, 1)
		$swapUsed  = [math]::Round(($swap | Measure-Object -Property CurrentUsage -Sum).Sum / 1024, 1)
		$swapPercent = if ($swapTotal -gt 0) { [math]::Round(($swapUsed / $swapTotal) * 100) } else { 0 }
		if ($swapPercent -ge 75) { $swapCol = $($color.red) }
		elseif ($swapPercent -ge 50) { $swapCol = $($color.yellow) }
		else { $swapCol = $($color.green) }
		if ($swapTotal -gt 0) {
			Write-Output "$($resolvedosc)Swap:          ${swapUsed}GB/${swapTotal}GB ($swapCol${swapPercent}%$($resolvedosc))"
		}
		$disks = Get-PhysicalDisk | Sort-Object DeviceId
		$prefix = "$($resolvedosc)Storage:       "
		$indent = " " * $prefix.Length
		Write-Host -NoNewline $prefix
		$first = $true
		foreach ($disk in $disks) {
			$size = $disk.Size
			$sizeStr = if ($size -ge 1000000000000) { "$([math]::Round($size / 1000000000000, 1))TB" }
				else { "$([math]::Round($size / 1000000000))GB" }
			$bus = $disk.BusType
			$type = $disk.MediaType
			$label = if ($bus -eq "NVMe") { "NVMe SSD" }
					 elseif ($bus -eq "USB") { "USB Drive" }
					 elseif ($type -eq "SSD") { "SATA SSD" }
					 elseif ($type -eq "HDD") { "HDD" }
					 elseif ($bus -eq "ATAPI") { "Disc Drive" }
					 else { "$bus $type".Trim() }
			if ($first) {
				Write-Output "$($resolvedosc)$sizeStr $label"
				$first = $false
			} else {
				Write-Output "$($resolvedosc)$indent$sizeStr $label"
			}
		}
		if ($script:mobo.manufacturer -eq "N/A") {
			if ($script:bios.manufacturer) {
				$moboman = $script:bios.Manufacturer
			} else {
				$moboman = "Generic" # moboman(TM).. or something
			}
		} else {
			$moboman = $script:mobo.Manufacturer
		}
		if ($script:mobo.product -eq "N/A") {
			$moboprod = "Motherboard"
		} else {
			$moboprod = $script:mobo.Product
		}
		Write-Output "$($resolvedosc)Motherboard:   $($moboman) $($moboprod)"
		if ($extra) {
			if ($script:csystem.Manufacturer) {
				$csysMan = $script:csystem.Manufacturer
			} else {
				if ($script:csysprod.Vendor) {
					$csysMan = $script:csysprod.Vendor
				}
			}
			if ($script:csystem.Model) {
				$csysModel = $script:csystem.Model
			} else {
				if (-not $script:csysprod) {
				}
				if ($script:csysprod.Model) {
					$csysModel = $script:csysprod.Model
				}
			}
			if ($script:csystem.PCSystemType) {
				$modtype = switch($script:csystem.PCSystemType) {
					1 {"Desktop Model: "}
					2 {"Laptop Model:  "}
					3 {"Desktop Model: "}
					4 {"Server Model:  "}
					5 {"Server Model:  "}
					6 {"Desktop Model: "}
					7 {"Server Model:  "}
					8 {"Tablet Model:  "} # what are you doing
			  default {"Device Model:  "}
				}
			}
			if ($battery -and $modtype -eq "Device Model:  ") {
				$modtype = "Laptop Model:  "
			}
			if ($csysMan -and $csysModel) {
				Write-Output "$($resolvedosc)$modtype$($csysMan) $($csysModel)"
			} elseif ($csysMan) {
				Write-Output "$($resolvedosc)Manufacturer:  $($csysMan)"
			} elseif ($csysModel) {
				Write-Output "$($resolvedosc)$modtype$($csysModel)"
			}
		}
		if ($battery) {
			if ($battery.EstimatedChargeRemaining -ge 75) {$batcol = $($color.green)}
			elseif ($battery.EstimatedChargeRemaining -ge 50) {$batcol = $($color.yellow)}
			elseif ($battery.EstimatedChargeRemaining -ge 25) {$batcol = $($color.orange)}
			else {$batcol = $($color.red)}
			$bstatus = switch ($battery.BatteryStatus) {
				2 {"[AC Connected / Not Charging]"}
				6 {"[AC Connected / Charging]"}
				7 {"[AC Connected / Charging]"}
				8 {"[AC Connected / Charging]"}
				9 {"[AC Connected / Charging]"}
				10 {"[No Battery]"}
		default {""} # no info needed, can just read percentage
			}
			if ($bstatus -eq "[AC Connected / Not Charging]") {
				if ($batteryValueFallback) {
					if ($batteryValueFallback.Charging) {
						$bstatus = "[AC Connected / Charging]"
					} elseif ($batteryValueFallback.Discharging) {
						$bstatus = "[AC Connected / Discharging]"
					}
				}
			}
			Write-Output "$($resolvedosc)Battery:       $($batcol)$($battery.EstimatedChargeRemaining)`%$($resolvedosc) $bstatus"
		}
		$uptime = (Get-Date) - $script:osInfo.LastBootUpTime
		$uptimeParts = @()
		if ($uptime.Days    -gt 0) { $uptimeParts += "$($uptime.Days)d"    }
		if ($uptime.Hours   -gt 0) { $uptimeParts += "$($uptime.Hours)h"   }
		if ($uptime.Minutes -gt 0) { $uptimeParts += "$($uptime.Minutes)m" }
		$uptimeStr = if ($uptimeParts.Count -gt 0) { $uptimeParts -join " " } else { "0m" }
		Write-Output "$($resolvedosc)Uptime:        $uptimeStr$($color.reset)"
	} elseif ($IsLinux) {
		Invoke-CfetchPanic "CFetch (Legacy Compat) is not available on Linux."
	} elseif ($IsMacOS) {
		write-output "cfetch is untested on MacOS.`nrunning it may cause issues or report false system information.`nrun anyways?`n$($color.green)y$($color.reset)/$($color.red)n$($color.reset)"
		$yn = (confirm "runanyways" "y" "n")
		if ($yn) {
			if ($Precise) {
				Write-output "$($resolvedosc)Kernel:        $(& uname -r)"
			} else {
				$kern = [System.Environment]::OSVersion.Version
				if (-not ($kern.Revision -ge 1)) {
					Write-output "$($resolvedosc)Kernel:        XNU $($kern.Major).$($kern.Minor).$($kern.Build)"
				} else {
					write-output "$($resolvedosc)Kernel:        XNU $($kern.Major).$($kern.Minor).$($kern.Build).$($kern.Revision)"
				}
			}
			if ($ESVersionTable -and $Precise) {
				write-output "$($resolvedosc)Shell:         emberShell $($ESVersionTable.ESEdition) $($ESVersionTable.ESVersion) `($($PSVersionTable.PSEdition) $($PSVersionTable.PSVersion)`)"
			} elseif ($ESVersionTable) {
				write-output "$($resolvedosc)Shell:         emberShell $($ESVersionTable.ESEdition) $($ESVersionTable.ESVersion)"
			} elseif ($Precise) {
				write-output "$($resolvedosc)Shell:         PowerShell $($PSVersionTable.PSEdition) $($PSVersionTable.PSVersion)"
			} else {
				write-output "$($resolvedosc)Shell:         PowerShell $($PSVersionTable.PSEdition) $("$($PSVersionTable.PSVersion)".Substring(0,5))"
			}
			if ($precise) {
				write-output "$($resolvedosc)Terminal:      $term $term_version"
			} else {
				write-output "$($resolvedosc)Terminal:      $term"
			}
			if($cursor) {
				Write-Output "$($resolvedosc)Cursor:        $cursor"
			}
			$cpu = sysctl -n machdep.cpu.brand_string
			$cores = sysctl -n hw.physicalcpu
			$threads = sysctl -n hw.logicalcpu
			Write-Output "$($resolvedosc)CPU:           $cpu"
			Write-Output "$($resolvedosc)CPU Cores:     $cores"
			Write-Output "$($resolvedosc)CPU Threads:   $threads"
			Write-Output "$($resolvedosc)CPU Base:      unsupported on macos"
			$ram = (sysctl -n hw.memsize) / 1GB
			Write-Output "$($resolvedosc)RAM:           $([math]::Round($ram,1))GB"
			Write-Output "$($resolvedosc)RAM Detail:    unsupported on macos"
			$gpuLine = system_profiler SPDisplaysDataType | Select-String "Chipset Model" | Select-Object -First 1
			if ($gpuLine) {
				$gpu = $gpuLine.ToString().Split(":")[1].Trim()
				Write-Output "$($resolvedosc)GPU:           $gpu"
			} else {
				Write-Output "$($resolvedosc)GPU:           unsupported on macos"
			}
			$disk = (df -h / | Select-Object -Last 1).Split()[1]
			Write-Output "$($resolvedosc)Storage:       $disk"
			Write-Output "$($resolvedosc)Storage Type:  unsupported on macos" # if you care about mac support a LOT a lot then.. PR pls
			Write-Output "$($resolvedosc)Motherboard:   unsupported on macos" # mac support is so scuffed.. we might as well drop it
			$uptimeRaw = uptime
			$uptime = (($uptimeRaw -split "up ")[1] -split ",")[0]
			Write-Output "$($resolvedosc)Uptime:        $uptime"
		}
	}
	if ($locale) {
			if ($PSCulture -and $PSUICulture) {
				write-output "$($resolvedosc)Locale:        $PSCulture$($color.reset)"
				write-output "$($resolvedosc)Language:      $PSUICulture$($color.reset)"
			} elseif ($host) {
				write-output "$($resolvedosc)Locale:        $($host.CurrentCulture)$($color.reset)"
				write-output "$($resolvedosc)Language:      $($host.CurrentUICulture)$($color.reset)"
			}
	}
	cdump
} # cfetch is over a thousand lines... jeez...
Export-ModuleMember -Variable color
Export-ModuleMember -Variable time
Export-ModuleMember -Variable esc
Export-ModuleMember -Function *

